//
//     and only now the hook, a `j` WITHOUT its delay slot: the
//     `addiu $sp, $sp, -16` runs live before the jump, the routine
//     accounts for it when reading the stack and the lerp undoes it on
//     return. The routine replays the displaced `lq` at the END and
//     returns to 0x00336BC0.
patch=1,EE,00336BB8,word,08039E00

// 44. poseframe -- Vermin's POSE before he sits down. After the
//     Riverside card, when "Okay, okay!" disappears.
//
//     The symptom: the root turns ~95 degrees of yaw in ONE tick and
//     the pose translation compensates with each end written in the
//     frame of ITS root. At 60 fps the half step interpolated the local
//     coordinates and composed them with the half-turned root: a jerk
//     stock does not have.
//
//     This section, where section 43 returns (0x00336BC0), for
//     SceneAnim's POSE channel (the caller read from the stack): on the
//     half step of a one-tick root turn, of pure yaw and with no event
//     on the next tick, it re-expresses both ends in XY in the frame of
//     the half-turned root -- P0 by -g/2, P1 by +g/2, with z and w of
//     the turn key's quaternion, which are the sine and cosine of g/2 --
//     and leaves the native lerp, Z and W as they were. It DEPENDS on
//     `rootturn`, `rootphase`, `scenevel`, `sceneyaw` and `scenerebase`.
//     It preserves $at and the 128-bit $t0..$t3, $f0..$f7 and the FCR31;
//     $v0/$v1 change on purpose. No mutable state. The routine, in its
//     cave:
//
//       0x000E8000  78C30000  lq    $v1, 0($a2)
//       0x000E8004  27BDFF40  addiu $sp, $sp, -192
//       0x000E8008  7FA10000  sq    $at, 0($sp)
//       0x000E800C  7FA80010  sq    $t0, 16($sp)
//       0x000E8010  7FA90020  sq    $t1, 32($sp)
//       0x000E8014  7FAA0030  sq    $t2, 48($sp)
//       0x000E8018  7FAB0040  sq    $t3, 64($sp)
//       0x000E801C  E7A00050  swc1  $f0, 80($sp)
//       0x000E8020  E7A10054  swc1  $f1, 84($sp)
//       0x000E8024  E7A20058  swc1  $f2, 88($sp)
//       0x000E8028  E7A3005C  swc1  $f3, 92($sp)
//       0x000E802C  E7A40060  swc1  $f4, 96($sp)
//       0x000E8030  E7A50064  swc1  $f5, 100($sp)
//       0x000E8034  E7A60068  swc1  $f6, 104($sp)
//       0x000E8038  E7A7006C  swc1  $f7, 108($sp)
//       0x000E803C  4448F800  cfc1  $t0, $f31
//       0x000E8040  AFA80070  sw    $t0, 112($sp)
//       0x000E8044  7FA20080  sq    $v0, 128($sp)
//       0x000E8048  7FA30090  sq    $v1, 144($sp)
//       0x000E804C  03E0402D  daddu $t0, $ra, $zero
//       0x000E8050  3C090010  lui   $t1, 0x0010
//       0x000E8054  35294CD4  ori   $t1, $t1, 19668
//       0x000E8058  150900A4  bne   $t0, $t1, 0x000E82EC
//       0x000E805C  00000000  nop
//       0x000E8060  8FA800F0  lw    $t0, 240($sp)
//       0x000E8064  3C090010  lui   $t1, 0x0010
//       0x000E8068  35294EC8  ori   $t1, $t1, 20168
//       0x000E806C  1509009F  bne   $t0, $t1, 0x000E82EC
//       0x000E8070  00000000  nop
//       0x000E8074  8FA80140  lw    $t0, 320($sp)
//       0x000E8078  3C090010  lui   $t1, 0x0010
//       0x000E807C  35296B7C  ori   $t1, $t1, 27516
//       0x000E8080  1509009A  bne   $t0, $t1, 0x000E82EC
//       0x000E8084  00000000  nop
//       0x000E8088  3C080051  lui   $t0, 0x0051
//       0x000E808C  350802CC  ori   $t0, $t0, 716
//       0x000E8090  8D080000  lw    $t0, 0($t0)
//       0x000E8094  3C093C88  lui   $t1, 0x3C88
//       0x000E8098  35298889  ori   $t1, $t1, -30583
//       0x000E809C  15090093  bne   $t0, $t1, 0x000E82EC
//       0x000E80A0  00000000  nop
//       0x000E80A4  3C080059  lui   $t0, 0x0059
//       0x000E80A8  35086D70  ori   $t0, $t0, 28016
//       0x000E80AC  91080000  lbu   $t0, 0($t0)
//       0x000E80B0  3C090000  lui   $t1, 0x0000
//       0x000E80B4  35290001  ori   $t1, $t1, 1
//       0x000E80B8  1509008C  bne   $t0, $t1, 0x000E82EC
//       0x000E80BC  00000000  nop
//       0x000E80C0  4408A000  mfc1  $t0, $f20
//       0x000E80C4  3C093F80  lui   $t1, 0x3F80
//       0x000E80C8  35290000  ori   $t1, $t1, 0
//       0x000E80CC  15090087  bne   $t0, $t1, 0x000E82EC
//       0x000E80D0  00000000  nop
//       0x000E80D4  9668001E  lhu   $t0, 30($s3)
//       0x000E80D8  31088013  andi  $t0, $t0, -32749
//       0x000E80DC  15000083  bne   $t0, $zero, 0x000E82EC
//       0x000E80E0  00000000  nop
//       0x000E80E4  46006006  mov.s $f0, $f12
//       0x000E80E8  3C013E80  lui   $at, 0x3E80
//       0x000E80EC  34210000  ori   $at, $at, 0
//       0x000E80F0  44810800  mtc1  $at, $f1
//       0x000E80F4  46010034  c.lt.s $f0, $f1
//       0x000E80F8  4501007C  bc1t   0x000E82EC
//       0x000E80FC  00000000  nop
//       0x000E8100  3C013F40  lui   $at, 0x3F40
//       0x000E8104  34210000  ori   $at, $at, 0
//       0x000E8108  44810800  mtc1  $at, $f1
//       0x000E810C  46010034  c.lt.s $f0, $f1
//       0x000E8110  45000076  bc1f   0x000E82EC
//       0x000E8114  00000000  nop
//       0x000E8118  966A001C  lhu   $t2, 28($s3)
//       0x000E811C  448A0000  mtc1  $t2, $f0
//       0x000E8120  00000000  nop
//       0x000E8124  46800020  cvt.s.w $f0, $f0
//       0x000E8128  4600A801  sub.s $f0, $f21, $f0

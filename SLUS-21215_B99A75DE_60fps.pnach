//
//     and only now the hooks. The pad one is a `j` and its slot is a
//     `nop`: the two exits back to the game (the toggle and the buttons
//     wrapper) replay the two displaced words. The render one lands on
//     a `jal` and jumps with `jal`, WITHOUT its slot: the
//     `addiu $a0, $s3, 0x840` is the interface's argument.
patch=1,EE,0014990C,word,08036080
patch=1,EE,00149910,word,00000000
patch=1,EE,00156714,word,0C036100

// 50. promptcycle -- the Triangle PROMPT at the Home Run fences: at
//     60 fps the Triangle that shows up at a fence blinked at double
//     speed (~15 Hz against stock's ~7.5).
//
//     The icon's animation controller (0x0019F328) counts integers per
//     HUD update, without dt: two updates visible and two hidden. The
//     HUD runs with the presented frame, so with the divider at 1 the
//     cycle lasted half as long.
//
//     This section hooks the ONLY caller of the controller and, with
//     the live divider at 1 and the frame counter odd, returns without
//     calling it: the same idea as section 15 (blinkrate), in another
//     block of the HUD. It saves $t0/$t1 in its own stack frame and
//     restores them before leaving; no memory or state. The routine, in
//     its cave:
//
//       0x000E9C00  27BDFFE0  addiu $sp, $sp, -32
//       0x000E9C04  7FA80000  sq    $t0, 0($sp)
//       0x000E9C08  7FA90010  sq    $t1, 16($sp)
//       0x000E9C0C  3C080059  lui   $t0, 0x0059
//       0x000E9C10  35086D70  ori   $t0, $t0, 28016
//       0x000E9C14  91080000  lbu   $t0, 0($t0)
//       0x000E9C18  24090001  addiu $t1, $zero, 1
//       0x000E9C1C  1509000B  bne   $t0, $t1, 0x000E9C4C
//       0x000E9C20  00000000  nop
//       0x000E9C24  3C080050  lui   $t0, 0x0050
//       0x000E9C28  3508C654  ori   $t0, $t0, -14764
//       0x000E9C2C  8D080000  lw    $t0, 0($t0)
//       0x000E9C30  31080001  andi  $t0, $t0, 1
//       0x000E9C34  11000005  beq   $t0, $zero, 0x000E9C4C
//       0x000E9C38  00000000  nop
//       0x000E9C3C  7BA80000  lq    $t0, 0($sp)
//       0x000E9C40  7BA90010  lq    $t1, 16($sp)
//       0x000E9C44  03E00008  jr    $ra
//       0x000E9C48  27BD0020  addiu $sp, $sp, 32
//       0x000E9C4C  7BA80000  lq    $t0, 0($sp)
//       0x000E9C50  7BA90010  lq    $t1, 16($sp)
//       0x000E9C54  08067CCA  j     0x0019F328
//       0x000E9C58  27BD0020  addiu $sp, $sp, 32
//
patch=1,EE,000E9C00,word,27BDFFE0
patch=1,EE,000E9C04,word,7FA80000
patch=1,EE,000E9C08,word,7FA90010
patch=1,EE,000E9C0C,word,3C080059
patch=1,EE,000E9C10,word,35086D70
patch=1,EE,000E9C14,word,91080000
patch=1,EE,000E9C18,word,24090001
patch=1,EE,000E9C1C,word,1509000B
patch=1,EE,000E9C20,word,00000000
patch=1,EE,000E9C24,word,3C080050
patch=1,EE,000E9C28,word,3508C654
patch=1,EE,000E9C2C,word,8D080000
patch=1,EE,000E9C30,word,31080001
patch=1,EE,000E9C34,word,11000005
patch=1,EE,000E9C38,word,00000000
patch=1,EE,000E9C3C,word,7BA80000
patch=1,EE,000E9C40,word,7BA90010
patch=1,EE,000E9C44,word,03E00008

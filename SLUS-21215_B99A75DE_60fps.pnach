//
//     and only now the hook: it lands on a `jal`, so it is a `jal`
//     ($ra = 0x0019F6C8, where the routine and the controller return)
//     and goes WITHOUT its delay slot: the `addiu $s0, $s2, 0x480` is
//     the child, which the caller uses after the return.
patch=1,EE,0019F6C0,word,0C03A700

// 51. cutland -- the camera JUMPS to a place where it STAYS. The subway
//     cutscene (`l55_c5`): at 60 fps a shot halfway through the camera's
//     jump could be seen.
//
//     The game's cut detector (|dot| < 0.98) only looks at orientation,
//     and here the camera jumps almost without turning. Section 37
//     (cutjump) needs the camera STILL before the jump; here it arrives
//     moving and LANDS somewhere it stays.
//
//     This section hooks the detector's threshold (0x00355CB4) and, for
//     SceneUpdate's active camera, with position keys contiguous and
//     one tick apart, in sync with the rotation keys, the next one equal
//     to its successor (which lasts two ticks or more) and a jump of
//     more than one unit and of more than 32 times the square of the
//     incoming step, it leaves $a2 = 1 and $f5 = 0 and exits through
//     section 28's hook: what the game leaves when it recognises a cut.
//     It DEPENDS on `cutshift` and `cutpose`. It preserves the 128-bit
//     $t0..$t5, $f12..$f15 and the FCR31. No mutable state. The
//     routine, in its cave:
//
//       0x000EA000  27BDFF70  addiu $sp, $sp, -144
//       0x000EA004  7FA80000  sq    $t0, 0($sp)
//       0x000EA008  7FA90010  sq    $t1, 16($sp)
//       0x000EA00C  7FAA0020  sq    $t2, 32($sp)
//       0x000EA010  7FAB0030  sq    $t3, 48($sp)
//       0x000EA014  7FAC0040  sq    $t4, 64($sp)
//       0x000EA018  7FAD0050  sq    $t5, 80($sp)
//       0x000EA01C  E7AC0060  swc1  $f12, 96($sp)
//       0x000EA020  E7AD0064  swc1  $f13, 100($sp)
//       0x000EA024  E7AE0068  swc1  $f14, 104($sp)
//       0x000EA028  E7AF006C  swc1  $f15, 108($sp)
//       0x000EA02C  4448F800  cfc1  $t0, $f31
//       0x000EA030  AFA80070  sw    $t0, 112($sp)
//       0x000EA034  3C080051  lui   $t0, 0x0051
//       0x000EA038  350802CC  ori   $t0, $t0, 716
//       0x000EA03C  8D080000  lw    $t0, 0($t0)
//       0x000EA040  3C093C88  lui   $t1, 0x3C88
//       0x000EA044  35298889  ori   $t1, $t1, -30583
//       0x000EA048  15090072  bne   $t0, $t1, 0x000EA214

// 28. cutshift -- the SHIFT STOCK APPLIES AT A CAMERA CUT. It goes
//     together with trackphase: correcting only the cursor leaves the
//     last fraction of the shift visible, measured.
//
//     The scene resource carries a root velocity impulse that
//     relocates the cop ~0.494 units at key 32 (time 1.0667), and the
//     camera cuts on that SAME key. Stock applies the shift when the
//     wide shot opens. The root translation reader (0x00104BC8, called
//     from 0x00104DC4) interpolates VELOCITY, which is integrated
//     afterwards, so at 60 fps the impulse of ONE key is spread over
//     its two neighbouring half frames:
//
//       actor time          unfixed        with this      stock
//       1.0500              0.125344       0              --
//       1.0667              0.247030       0.494061       0.494123
//       1.0833              0.123522       0              --
//
//     It REUSES THE GAME'S OWN CUT DETECTION, which is what makes it
//     sound: at 0x00355CAC..CD0 the camera interpolation compares the
//     product of its quaternions and, if abs(dot) < 0.98 (0x3F7AE148),
//     leaves $a2 at 1 and skips the factor. No actor speed threshold
//     and no list of characters were invented.
//
//     The DETECTOR (0x00355CEC) records at 0x000E23F0 the substep in
//     which the cut is going to land, when one to three half frames
//     remain:
//
//       n = trunc((t_next_key - t_track) * 60 + 0.5)   ; 1..3
//       [0x000E23F0] = n + [0x005104F4]
//
//     The window is 0.05078125 s and it is checked with an sltu on the
//     float's BITS, which also rejects negatives and NaN. It also
//     requires the track to drive the ACTIVE camera ([a3+8] ==
//     [0x005D9148]) and the base step to be 1/60.
//
//     The TRANSLATION (0x00104DC4), inside that window:
//
//       now - mark == -1   the PREVIOUS half frame: zero velocity
//                  ==  0   the frame of the cut: the sample x2
//                  == +1   the NEXT one: evaluates at the next 30 Hz
//                          integer (trunc(t + 0.75))
//
//     Outside those three substeps the original reader runs WITHOUT
//     touching its time. Its guards: the return address 0x00106B7C
//     (0x00106B74 is the jal 0x00104CE0, and that function saves its
//     $ra at [sp+0x40], which is where the routine reads it from), the
//     base step at 1/60 and $f20 == 1.0, which is the PLAYBACK SPEED
//     (0x00104D34 copies it from the $f12 the caller takes from
//     [scene+0x0C]).
//
//     It reaches every SceneAnim evaluated in that window, not only the
//     cop. It does not touch the bone or root quaternion decoders, the
//     shared cursors of those bones, or the camera rate: ordinary
//     tracking keeps its 60 Hz interpolation.
//
//     0x000E23F0 DOES NOT APPEAR BELOW AND MUST NOT: it is a word of
//     MUTABLE STATE written at run time, and a patch=1 line would wipe
//     it every frame while the detector uses it. The .pnach assumes RAM
//     is zero at boot, which is what PCSX2 leaves. A save state taken
//     with this section active may carry a valid value there: that is
//     not corruption.
//
//     The detector hook takes TWO words -- it displaces the
//     lui $at, 0x3F80 and the mtc1 $at, $f0, which the routine replays
//     at the end before returning to hook+8 -- so the second one is
//     NOPed here. The translation hook lands on a jal and so it jumps
//     with jal.
//
//     The detector, disassembled:
//
//       0x000E2400  27BDFFB0  addiu $sp, $sp, -80
//       0x000E2404  7FA80000  sq    $t0, 0($sp)
//       0x000E2408  7FA90010  sq    $t1, 16($sp)
//       0x000E240C  7FAA0020  sq    $t2, 32($sp)
//       0x000E2410  7FAB0030  sq    $t3, 48($sp)
//       0x000E2414  E7AD0040  swc1  $f13, 64($sp)
//       0x000E2418  E7AE0044  swc1  $f14, 68($sp)
//       0x000E241C  10C00029  beq   $a2, $zero, 0x000E24C4
//       0x000E2420  00000000  nop
//       0x000E2424  3C080051  lui   $t0, 0x0051
//       0x000E2428  350802CC  ori   $t0, $t0, 716
//       0x000E242C  8D080000  lw    $t0, 0($t0)
//       0x000E2430  3C093C88  lui   $t1, 0x3C88
//       0x000E2434  35298889  ori   $t1, $t1, -30583
//       0x000E2438  15090022  bne   $t0, $t1, 0x000E24C4
//       0x000E243C  00000000  nop
//       0x000E2440  3C08005D  lui   $t0, 0x005D
//       0x000E2444  35089148  ori   $t0, $t0, -28344
//       0x000E2448  8D080000  lw    $t0, 0($t0)
//       0x000E244C  8CE90008  lw    $t1, 8($a3)
//       0x000E2450  1509001C  bne   $t0, $t1, 0x000E24C4
//       0x000E2454  00000000  nop
//       0x000E2458  C4ED0010  lwc1  $f13, 16($a3)
//       0x000E245C  460D2341  sub.s $f13, $f4, $f13
//       0x000E2460  44096800  mfc1  $t1, $f13
//       0x000E2464  3C083D50  lui   $t0, 0x3D50
//       0x000E2468  35080000  ori   $t0, $t0, 0
//       0x000E246C  0128502B  sltu  $t2, $t1, $t0
//       0x000E2470  11400014  beq   $t2, $zero, 0x000E24C4
//       0x000E2474  00000000  nop
//       0x000E2478  3C084270  lui   $t0, 0x4270
//       0x000E247C  35080000  ori   $t0, $t0, 0
//       0x000E2480  44887000  mtc1  $t0, $f14
//       0x000E2484  460E6B42  mul.s $f13, $f13, $f14
//       0x000E2488  3C083F00  lui   $t0, 0x3F00
//       0x000E248C  35080000  ori   $t0, $t0, 0
//       0x000E2490  44887000  mtc1  $t0, $f14
//       0x000E2494  460E6B40  add.s $f13, $f13, $f14
//       0x000E2498  46006B64  cvt.w.s $f13, $f13
//       0x000E249C  44096800  mfc1  $t1, $f13
//       0x000E24A0  11200008  beq   $t1, $zero, 0x000E24C4
//       0x000E24A4  00000000  nop
//       0x000E24A8  3C080051  lui   $t0, 0x0051
//       0x000E24AC  350804F4  ori   $t0, $t0, 1268
//       0x000E24B0  8D080000  lw    $t0, 0($t0)
//       0x000E24B4  01284821  addu  $t1, $t1, $t0
//       0x000E24B8  3C08000E  lui   $t0, 0x000E
//       0x000E24BC  350823F0  ori   $t0, $t0, 9200
//       0x000E24C0  AD090000  sw    $t1, 0($t0)
//       0x000E24C4  C7AD0040  lwc1  $f13, 64($sp)
//       0x000E24C8  C7AE0044  lwc1  $f14, 68($sp)
//       0x000E24CC  7BA80000  lq    $t0, 0($sp)
//       0x000E24D0  7BA90010  lq    $t1, 16($sp)
//       0x000E24D4  7BAA0020  lq    $t2, 32($sp)
//       0x000E24D8  7BAB0030  lq    $t3, 48($sp)
//       0x000E24DC  27BD0050  addiu $sp, $sp, 80
//       0x000E24E0  3C013F80  lui   $at, 0x3F80
//       0x000E24E4  44810000  mtc1  $at, $f0
//       0x000E24E8  080D573D  j     0x00355CF4
//       0x000E24EC  00000000  nop
//
//     and the translation:
//
//       0x000E2600  27BDFFB0  addiu $sp, $sp, -80
//       0x000E2604  7FA80000  sq    $t0, 0($sp)
//       0x000E2608  7FA90010  sq    $t1, 16($sp)
//       0x000E260C  E7AD0020  swc1  $f13, 32($sp)
//       0x000E2610  FFBF0030  sd    $ra, 48($sp)
//       0x000E2614  AFA5002C  sw    $a1, 44($sp)
//       0x000E2618  8FA80090  lw    $t0, 144($sp)
//       0x000E261C  3C090010  lui   $t1, 0x0010
//       0x000E2620  35296B7C  ori   $t1, $t1, 27516
//       0x000E2624  15090043  bne   $t0, $t1, 0x000E2734
//       0x000E2628  00000000  nop
//       0x000E262C  3C080051  lui   $t0, 0x0051
//       0x000E2630  350802CC  ori   $t0, $t0, 716
//       0x000E2634  8D080000  lw    $t0, 0($t0)
//       0x000E2638  3C093C88  lui   $t1, 0x3C88
//       0x000E263C  35298889  ori   $t1, $t1, -30583
//       0x000E2640  1509003C  bne   $t0, $t1, 0x000E2734
//       0x000E2644  00000000  nop
//       0x000E2648  4408A000  mfc1  $t0, $f20
//       0x000E264C  3C093F80  lui   $t1, 0x3F80
//       0x000E2650  35290000  ori   $t1, $t1, 0
//       0x000E2654  15090037  bne   $t0, $t1, 0x000E2734
//       0x000E2658  00000000  nop
//       0x000E265C  3C08000E  lui   $t0, 0x000E
//       0x000E2660  350823F0  ori   $t0, $t0, 9200
//       0x000E2664  8D080000  lw    $t0, 0($t0)
//       0x000E2668  11000032  beq   $t0, $zero, 0x000E2734
//       0x000E266C  00000000  nop
//       0x000E2670  3C090051  lui   $t1, 0x0051
//       0x000E2674  352904F4  ori   $t1, $t1, 1268
//       0x000E2678  8D290000  lw    $t1, 0($t1)
//       0x000E267C  01284023  subu  $t0, $t1, $t0
//       0x000E2680  3C09FFFF  lui   $t1, 0xFFFF
//       0x000E2684  3529FFFF  ori   $t1, $t1, -1
//       0x000E2688  1109000F  beq   $t0, $t1, 0x000E26C8
//       0x000E268C  00000000  nop
//       0x000E2690  11000015  beq   $t0, $zero, 0x000E26E8
//       0x000E2694  00000000  nop
//       0x000E2698  3C090000  lui   $t1, 0x0000
//       0x000E269C  35290001  ori   $t1, $t1, 1
//       0x000E26A0  15090024  bne   $t0, $t1, 0x000E2734
//       0x000E26A4  00000000  nop
//       0x000E26A8  3C083F40  lui   $t0, 0x3F40
//       0x000E26AC  35080000  ori   $t0, $t0, 0
//       0x000E26B0  44886800  mtc1  $t0, $f13
//       0x000E26B4  460D6300  add.s $f12, $f12, $f13
//       0x000E26B8  46006324  cvt.w.s $f12, $f12
//       0x000E26BC  46806320  cvt.s.w $f12, $f12
//       0x000E26C0  1000001C  beq   $zero, $zero, 0x000E2734
//       0x000E26C4  00000000  nop
//       0x000E26C8  ACA00000  sw    $zero, 0($a1)
//       0x000E26CC  ACA00004  sw    $zero, 4($a1)
//       0x000E26D0  ACA00008  sw    $zero, 8($a1)
//       0x000E26D4  3C083F80  lui   $t0, 0x3F80
//       0x000E26D8  35080000  ori   $t0, $t0, 0
//       0x000E26DC  ACA8000C  sw    $t0, 12($a1)
//       0x000E26E0  1000000D  beq   $zero, $zero, 0x000E2718
//       0x000E26E4  00000000  nop
//       0x000E26E8  0C0412F2  jal   0x00104BC8

// 46. workoutrate -- the EFFORT in Sit Ups (Triangle and mashing X).
//     The other exercises share the same controller.
//
//     The symptom: the exercise controller (0x00255540) adds effort
//     (Human+0x670) while the hold of each X lasts (Human+0x674) and
//     subtracts it without one, once per update and without dt. At
//     60 fps the same X cadence held half as long and lost twice as
//     much: more presses were needed (75 against 46 at 6 Hz) and the
//     arms never reached the fast blend.
//
//     This section, with dt 1/60 and live divider 1: the initial hold
//     (6) and each recharge DOUBLED, and the gain and the loss already
//     computed HALVED. Caps, threshold, tables and blend stay native.
//     Outside those conditions, native behaviour. Four routines, one per
//     hook, each preserving the 128-bit $t0-$t2 and $f31; no mutable
//     state. The routines, in their cave:
//
//       0x000E9000  27BDFFC0  addiu $sp, $sp, -64
//       0x000E9004  7FA80000  sq    $t0, 0($sp)
//       0x000E9008  7FA90010  sq    $t1, 16($sp)
//       0x000E900C  7FAA0020  sq    $t2, 32($sp)
//       0x000E9010  E7BF0030  swc1  $f31, 48($sp)
//       0x000E9014  0040502D  daddu $t2, $v0, $zero
//       0x000E9018  3C080051  lui   $t0, 0x0051
//       0x000E901C  350802CC  ori   $t0, $t0, 716
//       0x000E9020  8D080000  lw    $t0, 0($t0)
//       0x000E9024  3C093C88  lui   $t1, 0x3C88
//       0x000E9028  35298889  ori   $t1, $t1, -30583
//       0x000E902C  15090008  bne   $t0, $t1, 0x000E9050
//       0x000E9030  00000000  nop
//       0x000E9034  3C080059  lui   $t0, 0x0059
//       0x000E9038  35086D70  ori   $t0, $t0, 28016
//       0x000E903C  91080000  lbu   $t0, 0($t0)
//       0x000E9040  24090001  addiu $t1, $zero, 1
//       0x000E9044  15090002  bne   $t0, $t1, 0x000E9050
//       0x000E9048  00000000  nop
//       0x000E904C  000A5040  sll   $t2, $t2, 1
//       0x000E9050  AE2A0674  sw    $t2, 1652($s1)
//       0x000E9054  C7BF0030  lwc1  $f31, 48($sp)
//       0x000E9058  7BA80000  lq    $t0, 0($sp)
//       0x000E905C  7BA90010  lq    $t1, 16($sp)
//       0x000E9060  7BAA0020  lq    $t2, 32($sp)
//       0x000E9064  27BD0040  addiu $sp, $sp, 64
//       0x000E9068  08095622  j     0x00255888
//       0x000E906C  00000000  nop

//
//     The routine that maintains it, hooked where the three paths of
//     the ring updater converge. It takes TWO words because the next
//     one is a beq, and a branch in the delay slot of a jump is
//     undefined: the routine replays it at the end.
//
//     0x000F1C80  8E28002C  lw    $t0, 44($s1)
//     0x000F1C84  2629001C  addiu $t1, $s1, 28
//     0x000F1C88  3C010051  lui   $at, 0x0051
//     0x000F1C8C  8C21C654  lw    $at, -14764($at)
//     0x000F1C90  00085040  sll   $t2, $t0, 1
//     0x000F1C94  012A5021  addu  $t2, $t1, $t2
//     0x000F1C98  954B0000  lhu   $t3, 0($t2)
//     0x000F1C9C  262CA600  addiu $t4, $s1, -23040
//     0x000F1CA0  8D8D002C  lw    $t5, 44($t4)
//     0x000F1CA4  258E001C  addiu $t6, $t4, 28
//     0x000F1CA8  30210001  andi  $at, $at, 1
//     0x000F1CAC  14200004  bne   $at, $zero, 0x000F1CC0
//     0x000F1CB0  00000000  nop
//     0x000F1CB4  25AD0001  addiu $t5, $t5, 1
//     0x000F1CB8  31AD0007  andi  $t5, $t5, 7
//     0x000F1CBC  AD8D002C  sw    $t5, 44($t4)
//     0x000F1CC0  000D7840  sll   $t7, $t5, 1
//     0x000F1CC4  01CF7821  addu  $t7, $t6, $t7
//     0x000F1CC8  A5EB0000  sh    $t3, 0($t7)
//     0x000F1CCC  8E22004C  lw    $v0, 76($s1)
//     0x000F1CD0  00000000  nop
//     0x000F1CD4  10400003  beq   $v0, $zero, 0x000F1CE4
//     0x000F1CD8  00000000  nop
//     0x000F1CDC  08051427  j     0x0014509C
//     0x000F1CE0  00000000  nop
//     0x000F1CE4  08051520  j     0x00145480
//     0x000F1CE8  7BB000A0  lq    $s0, 160($sp)
//
patch=1,EE,000F1C80,word,8E28002C
patch=1,EE,000F1C84,word,2629001C
patch=1,EE,000F1C88,word,3C010051
patch=1,EE,000F1C8C,word,8C21C654
patch=1,EE,000F1C90,word,00085040
patch=1,EE,000F1C94,word,012A5021
patch=1,EE,000F1C98,word,954B0000
patch=1,EE,000F1C9C,word,262CA600
patch=1,EE,000F1CA0,word,8D8D002C
patch=1,EE,000F1CA4,word,258E001C
patch=1,EE,000F1CA8,word,30210001
patch=1,EE,000F1CAC,word,14200004
patch=1,EE,000F1CB0,word,00000000
patch=1,EE,000F1CB4,word,25AD0001
patch=1,EE,000F1CB8,word,31AD0007
patch=1,EE,000F1CBC,word,AD8D002C
patch=1,EE,000F1CC0,word,000D7840
patch=1,EE,000F1CC4,word,01CF7821

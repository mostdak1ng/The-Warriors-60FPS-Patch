// 32. stealthmove -- STEALTH + L1 + a valid target barely lets you
//     WALK.
//
//     The symptom: in the shadows, with L1 held on a valid target, the
//     character stays nailed to the floor. Measured: two seconds of
//     stick move it 0.07022 units against stock's 3.21949. To reproduce
//     it, press L1 FIRST and then the stick: starting both at once
//     hides the defect.
//
//     The cause is two numbers that did not cross at 30 Hz. The
//     player's locomotion controller (0x00240E38) accelerates 24 * dt
//     at 0x002418FC..0x00241920, so the FIRST increment from rest is
//     0.8 in stock and 0.4 at 60 Hz. The animation selection
//     (0x00259578) measures the horizontal speed WarMove hands it -- it
//     stays in $f21 -- and at 0x00259EF8..0x00259F1C compares it
//     against 0.25 * base_speed, which it queries through 0x00221580;
//     for Cleon that base is 1.731455326, i.e. a threshold of
//     0.432863832.
//
//       0.4 < 0.433
//
//     The first step at 60 Hz falls short, the stealth path keeps the
//     resting substate, the selection goes back to the idle routine
//     (0x0025F770) and that one sets the requested state to zero
//     (0x0025FA24). The controller's next pass asks for the start
//     again and finds zero speed: a row of aborted starts.
//
//     It is NOT the acceleration or the classifier. Doubling the
//     acceleration unblocks it but would change locomotion for the
//     whole game; lowering the 0.5 of the classifier at 0x0022AEB0
//     fixes nothing; and the patch reduced to its core (sections 1-6)
//     fails the same way, so no other section causes it.
//
//     The hook replaces the pair that loads the 0.25 --
//     lui $at, 0x3E80 / mtc1 $at, $f1 -- and the routine REPLAYS it: it
//     keeps stock's threshold unless FIVE conditions hold, all of them
//     reads and none of them writes.
//
//       1. the global timestep is exactly 1/60;
//       2. the human's state has bits 0x200000 and 0x8 -- the same
//          combination the native 0x00228188 checks, which calls
//          0x002265F0 twice on [Human+0xD4], which is exactly the $s1
//          this function loads in its prologue;
//       3. the human's controller is the native 0x00240E38 -- the
//          comparison is written the same as at 0x0023FBDC and
//          0x0027D3F0;
//       4. $f21 is strictly positive and finite;
//       5. the player's input is active in its pad descriptor -- the
//          table at 0x00660F50, stride 44 --, its selector is 0 or 1,
//          and the stick magnitude passes the native 0.12 and is
//          finite.
//
//     In that combination the threshold factor becomes ZERO and the
//     animation decision accepts the first half step the player asked
//     for. It writes no speed, acceleration, position, orientation,
//     state, target or pad data; on releasing the stick the comparison
//     goes back to the original, so the normal STOP condition still
//     exists. At 30 fps the first guard keeps it inert.
//
//     The descriptor is resolved like the native 0x0021D3E8 but with
//     shifts and adds (x32 + x8 + x4 = x44) instead of its `mult`: a
//     `mult` here would clobber the caller's HI/LO.
//
//     Measured, two seconds of stick to the left after locking on to
//     Vermin:
//
//       stock               displacement 3.21949   1.731455 u/s
//       without this                     0.07022   0.040000 u/s
//       with this                        3.21426   1.731455 u/s
//
//     Without L1, without stealth and without a target nearby the
//     traces are IDENTICAL with and without this section, and stock
//     plus this section matches stock.
//
//     The routine, in the cave:
//
//       0x000E3600  3C013E80  lui   $at, 0x3E80
//       0x000E3604  44810800  mtc1  $at, $f1
//       0x000E3608  27BDFFD0  addiu $sp, $sp, -48
//       0x000E360C  7FA80000  sq    $t0, 0($sp)
//       0x000E3610  7FA90010  sq    $t1, 16($sp)
//       0x000E3614  7FAA0020  sq    $t2, 32($sp)
//       0x000E3618  3C080051  lui   $t0, 0x0051
//       0x000E361C  350802CC  ori   $t0, $t0, 716
//       0x000E3620  8D080000  lw    $t0, 0($t0)
//       0x000E3624  3C093C88  lui   $t1, 0x3C88
//       0x000E3628  35298889  ori   $t1, $t1, -30583
//       0x000E362C  15090036  bne   $t0, $t1, 0x000E3708
//       0x000E3630  00000000  nop
//       0x000E3634  8E280000  lw    $t0, 0($s1)
//       0x000E3638  3C090020  lui   $t1, 0x0020
//       0x000E363C  35290008  ori   $t1, $t1, 8
//       0x000E3640  01094024  and   $t0, $t0, $t1
//       0x000E3644  15090030  bne   $t0, $t1, 0x000E3708
//       0x000E3648  00000000  nop
//       0x000E364C  8E4801C0  lw    $t0, 448($s2)
//       0x000E3650  3C090024  lui   $t1, 0x0024
//       0x000E3654  35290E38  ori   $t1, $t1, 3640
//       0x000E3658  1509002B  bne   $t0, $t1, 0x000E3708
//       0x000E365C  00000000  nop
//       0x000E3660  4408A800  mfc1  $t0, $f21
//       0x000E3664  0008482A  slt   $t1, $zero, $t0
//       0x000E3668  11200027  beq   $t1, $zero, 0x000E3708
//       0x000E366C  00000000  nop
//       0x000E3670  3C097F80  lui   $t1, 0x7F80
//       0x000E3674  35290000  ori   $t1, $t1, 0
//       0x000E3678  0109482B  sltu  $t1, $t0, $t1
//       0x000E367C  11200022  beq   $t1, $zero, 0x000E3708
//       0x000E3680  00000000  nop
//       0x000E3684  86480092  lh    $t0, 146($s2)
//       0x000E3688  2D094000  sltiu $t1, $t0, 16384
//       0x000E368C  1120001E  beq   $t1, $zero, 0x000E3708
//       0x000E3690  00000000  nop
//       0x000E3694  00084940  sll   $t1, $t0, 5
//       0x000E3698  000850C0  sll   $t2, $t0, 3
//       0x000E369C  012A4821  addu  $t1, $t1, $t2
//       0x000E36A0  00084080  sll   $t0, $t0, 2
//       0x000E36A4  01284021  addu  $t0, $t1, $t0
//       0x000E36A8  3C090066  lui   $t1, 0x0066
//       0x000E36AC  35290F50  ori   $t1, $t1, 3920
//       0x000E36B0  01094021  addu  $t0, $t0, $t1
//       0x000E36B4  9109001B  lbu   $t1, 27($t0)
//       0x000E36B8  11200013  beq   $t1, $zero, 0x000E3708
//       0x000E36BC  00000000  nop
//       0x000E36C0  91090018  lbu   $t1, 24($t0)
//       0x000E36C4  2D2A0002  sltiu $t2, $t1, 2
//       0x000E36C8  1140000F  beq   $t2, $zero, 0x000E3708
//       0x000E36CC  00000000  nop
//       0x000E36D0  00094880  sll   $t1, $t1, 2
//       0x000E36D4  01094021  addu  $t0, $t0, $t1
//       0x000E36D8  8D080010  lw    $t0, 16($t0)
//       0x000E36DC  3C093DF5  lui   $t1, 0x3DF5
//       0x000E36E0  3529C28F  ori   $t1, $t1, -15729
//       0x000E36E4  0128482B  sltu  $t1, $t1, $t0
//       0x000E36E8  11200007  beq   $t1, $zero, 0x000E3708
//       0x000E36EC  00000000  nop
//       0x000E36F0  3C097F80  lui   $t1, 0x7F80
//       0x000E36F4  35290000  ori   $t1, $t1, 0
//       0x000E36F8  0109482B  sltu  $t1, $t0, $t1
//       0x000E36FC  11200002  beq   $t1, $zero, 0x000E3708
//       0x000E3700  00000000  nop
//       0x000E3704  44800800  mtc1  $zero, $f1
//       0x000E3708  7BA80000  lq    $t0, 0($sp)

//
//     Five routines: the button context and its wrapper (first: the
//     queue jumps to the wrapper), the queue, the toggle and the notice
//     (with its two texts at the end):
//
//       0x000B0600  3C020051  lui   $v0, 0x0051
//       0x000B0604  344202CC  ori   $v0, $v0, 716
//       0x000B0608  8C420000  lw    $v0, 0($v0)
//       0x000B060C  3C033C88  lui   $v1, 0x3C88
//       0x000B0610  34638889  ori   $v1, $v1, -30583
//       0x000B0614  144300CA  bne   $v0, $v1, 0x000B0940
//       0x000B0618  00000000  nop
//       0x000B061C  3C020059  lui   $v0, 0x0059
//       0x000B0620  34426D70  ori   $v0, $v0, 28016
//       0x000B0624  90420000  lbu   $v0, 0($v0)
//       0x000B0628  24030001  addiu $v1, $zero, 1
//       0x000B062C  144300C4  bne   $v0, $v1, 0x000B0940
//       0x000B0630  00000000  nop
//       0x000B0634  3C080051  lui   $t0, 0x0051
//       0x000B0638  3508489C  ori   $t0, $t0, 18588
//       0x000B063C  8D080000  lw    $t0, 0($t0)
//       0x000B0640  31020003  andi  $v0, $t0, 3
//       0x000B0644  144000BE  bne   $v0, $zero, 0x000B0940
//       0x000B0648  00000000  nop
//       0x000B064C  3C030060  lui   $v1, 0x0060
//       0x000B0650  34630000  ori   $v1, $v1, 0
//       0x000B0654  0103102B  sltu  $v0, $t0, $v1
//       0x000B0658  144000B9  bne   $v0, $zero, 0x000B0940
//       0x000B065C  00000000  nop
//       0x000B0660  3C0301FF  lui   $v1, 0x01FF
//       0x000B0664  3463FD00  ori   $v1, $v1, -768
//       0x000B0668  0103102B  sltu  $v0, $t0, $v1
//       0x000B066C  104000B4  beq   $v0, $zero, 0x000B0940
//       0x000B0670  00000000  nop
//       0x000B0674  01044021  addu  $t0, $t0, $a0
//       0x000B0678  8D090228  lw    $t1, 552($t0)
//       0x000B067C  2402FFFF  addiu $v0, $zero, -1
//       0x000B0680  112200AF  beq   $t1, $v0, 0x000B0940
//       0x000B0684  00000000  nop
//       0x000B0688  00094402  srl   $t0, $t1, 16
//       0x000B068C  000840C0  sll   $t0, $t0, 3
//       0x000B0690  3C03006E  lui   $v1, 0x006E
//       0x000B0694  3463BD38  ori   $v1, $v1, -17096
//       0x000B0698  01034021  addu  $t0, $t0, $v1
//       0x000B069C  95020004  lhu   $v0, 4($t0)
//       0x000B06A0  3123FFFF  andi  $v1, $t1, -1
//       0x000B06A4  144300A6  bne   $v0, $v1, 0x000B0940
//       0x000B06A8  00000000  nop
//       0x000B06AC  8D090000  lw    $t1, 0($t0)
//       0x000B06B0  31220003  andi  $v0, $t1, 3
//       0x000B06B4  144000A2  bne   $v0, $zero, 0x000B0940
//       0x000B06B8  00000000  nop
//       0x000B06BC  3C030060  lui   $v1, 0x0060
//       0x000B06C0  34630000  ori   $v1, $v1, 0
//       0x000B06C4  0123102B  sltu  $v0, $t1, $v1
//       0x000B06C8  1440009D  bne   $v0, $zero, 0x000B0940
//       0x000B06CC  00000000  nop
//       0x000B06D0  3C0301FF  lui   $v1, 0x01FF
//       0x000B06D4  3463F900  ori   $v1, $v1, -1792
//       0x000B06D8  0123102B  sltu  $v0, $t1, $v1
//       0x000B06DC  10400098  beq   $v0, $zero, 0x000B0940
//       0x000B06E0  00000000  nop
//       0x000B06E4  0120502D  daddu $t2, $t1, $zero
//       0x000B06E8  914201B0  lbu   $v0, 432($t2)
//       0x000B06EC  00021080  sll   $v0, $v0, 2
//       0x000B06F0  14440093  bne   $v0, $a0, 0x000B0940
//       0x000B06F4  00000000  nop
//       0x000B06F8  8D490338  lw    $t1, 824($t2)
//       0x000B06FC  2402FFFF  addiu $v0, $zero, -1
//       0x000B0700  1122002F  beq   $t1, $v0, 0x000B07C0
//       0x000B0704  00000000  nop

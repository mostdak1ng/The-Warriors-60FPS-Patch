//       0x000E2B40  8E620120  lw    $v0, 288($s3)
//       0x000E2B44  10400024  beq   $v0, $zero, 0x000E2BD8
//       0x000E2B48  00000000  nop
//       0x000E2B4C  94430002  lhu   $v1, 2($v0)
//       0x000E2B50  24070040  addiu $a3, $zero, 64
//       0x000E2B54  14670020  bne   $v1, $a3, 0x000E2BD8
//       0x000E2B58  00000000  nop
//       0x000E2B5C  94430000  lhu   $v1, 0($v0)
//       0x000E2B60  96670128  lhu   $a3, 296($s3)
//       0x000E2B64  00671823  subu  $v1, $v1, $a3
//       0x000E2B68  90870008  lbu   $a3, 8($a0)
//       0x000E2B6C  00E63821  addu  $a3, $a3, $a2
//       0x000E2B70  14670019  bne   $v1, $a3, 0x000E2BD8
//       0x000E2B74  00000000  nop
//       0x000E2B78  27BDFFE0  addiu $sp, $sp, -32
//       0x000E2B7C  FFBF0010  sd    $ra, 16($sp)
//       0x000E2B80  AFA20000  sw    $v0, 0($sp)
//       0x000E2B84  0C0412F2  jal   0x00104BC8
//       0x000E2B88  00000000  nop
//       0x000E2B8C  8FA20000  lw    $v0, 0($sp)
//       0x000E2B90  C4410008  lwc1  $f1, 8($v0)
//       0x000E2B94  C6000010  lwc1  $f0, 16($s0)

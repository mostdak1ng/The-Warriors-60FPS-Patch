//
//     and only now the two hooks, `j` WITHOUT their delay slot: the
//     `lui $a0, 0x51` and the `lq $s0, 0x40($sp)` run live before the
//     jump. `wait` returns to 0x0019EDB4 (asks) or 0x0019EDCC (does not
//     ask); `anchor` replays the sw of the handle and returns to
//     0x0019EDF8.
patch=1,EE,0019EDAC,word,0803BC00
patch=1,EE,0019EDF0,word,0803BC60

// 56. flamewait -- the molotov's FIRE went out sooner. The flames a
//     molotov leaves on the ground lasted less than in stock (mean
//     3258 ms against 4060 over the same 17 flames).
//
//     The flames (class sub_fade_flame, 0x00513E50) are rescheduled on
//     section 20's scene wheel with a random wait of 2 or 3 slots, and
//     their life counts INVOCATIONS. Section 20 turns every wait of 2
//     into 1: this class was left with 80% of its stock life.
//
//     This section hooks the entry of the reinsertion (0x003A3478) and
//     puts the wait back to 2 ONLY if: it comes from the dispatcher
//     (return address 0x003A365C), the wait is 1, the live divider is
//     1, dt is exactly 1/60, the object is a sub_fade_flame (vtable and
//     definition) and its request was 2. Everything else stays native:
//     the rest of section 20 is unchanged. It applies to every flame of
//     that class, not only the molotov. No dependencies: without
//     section 20 it does nothing. It preserves the 128-bit $t0-$t1; no
//     state. The routine, in its cave:
//
//       0x000EF800  8C870004  lw    $a3, 4($a0)
//       0x000EF804  27BDFFE0  addiu $sp, $sp, -32
//       0x000EF808  7FA80000  sq    $t0, 0($sp)
//       0x000EF80C  7FA90010  sq    $t1, 16($sp)
//       0x000EF810  3C08003A  lui   $t0, 0x003A
//       0x000EF814  3508365C  ori   $t0, $t0, 13916
//       0x000EF818  17E8001F  bne   $ra, $t0, 0x000EF898
//       0x000EF81C  00000000  nop
//       0x000EF820  24080001  addiu $t0, $zero, 1
//       0x000EF824  14C8001C  bne   $a2, $t0, 0x000EF898
//       0x000EF828  00000000  nop
//       0x000EF82C  3C090059  lui   $t1, 0x0059
//       0x000EF830  35296D70  ori   $t1, $t1, 28016
//       0x000EF834  91290000  lbu   $t1, 0($t1)
//       0x000EF838  15280017  bne   $t1, $t0, 0x000EF898
//       0x000EF83C  00000000  nop
//       0x000EF840  3C080051  lui   $t0, 0x0051
//       0x000EF844  350802CC  ori   $t0, $t0, 716
//       0x000EF848  8D080000  lw    $t0, 0($t0)
//       0x000EF84C  3C093C88  lui   $t1, 0x3C88
//       0x000EF850  35298889  ori   $t1, $t1, -30583
//       0x000EF854  15090010  bne   $t0, $t1, 0x000EF898
//       0x000EF858  00000000  nop
//       0x000EF85C  8CA80000  lw    $t0, 0($a1)
//       0x000EF860  3C090054  lui   $t1, 0x0054
//       0x000EF864  35295660  ori   $t1, $t1, 22112
//       0x000EF868  1509000B  bne   $t0, $t1, 0x000EF898
//       0x000EF86C  00000000  nop
//       0x000EF870  8CA800E0  lw    $t0, 224($a1)
//       0x000EF874  3C090051  lui   $t1, 0x0051
//       0x000EF878  35293E50  ori   $t1, $t1, 15952
//       0x000EF87C  15090006  bne   $t0, $t1, 0x000EF898
//       0x000EF880  00000000  nop
//       0x000EF884  94A8006E  lhu   $t0, 110($a1)
//       0x000EF888  24090002  addiu $t1, $zero, 2
//       0x000EF88C  15090002  bne   $t0, $t1, 0x000EF898
//       0x000EF890  00000000  nop
//       0x000EF894  24060002  addiu $a2, $zero, 2
//       0x000EF898  7BA80000  lq    $t0, 0($sp)
//       0x000EF89C  7BA90010  lq    $t1, 16($sp)
//       0x000EF8A0  27BD0020  addiu $sp, $sp, 32
//       0x000EF8A4  080E8D20  j     0x003A3480
//       0x000EF8A8  00000000  nop
//
patch=1,EE,000EF800,word,8C870004
patch=1,EE,000EF804,word,27BDFFE0
patch=1,EE,000EF808,word,7FA80000
patch=1,EE,000EF80C,word,7FA90010

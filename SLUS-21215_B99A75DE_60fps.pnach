//       0x000F5A34  35298889  ori   $t1, $t1, -30583
//       0x000F5A38  1509000C  bne   $t0, $t1, 0x000F5A6C
//       0x000F5A3C  00000000  nop
//       0x000F5A40  3C080050  lui   $t0, 0x0050
//       0x000F5A44  3508C654  ori   $t0, $t0, -14764
//       0x000F5A48  8D080000  lw    $t0, 0($t0)
//       0x000F5A4C  31080001  andi  $t0, $t0, 1
//       0x000F5A50  11000006  beq   $t0, $zero, 0x000F5A6C
//       0x000F5A54  00000000  nop
//       0x000F5A58  7BA80000  lq    $t0, 0($sp)
//       0x000F5A5C  7BA90010  lq    $t1, 16($sp)
//       0x000F5A60  27BD0020  addiu $sp, $sp, 32
//       0x000F5A64  03E00008  jr    $ra
//       0x000F5A68  0000102D  daddu $v0, $zero, $zero
//       0x000F5A6C  7BA80000  lq    $t0, 0($sp)
//       0x000F5A70  7BA90010  lq    $t1, 16($sp)

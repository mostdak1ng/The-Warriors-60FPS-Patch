//
//     and only now the hook, a `j` WITHOUT its delay slot: what it
//     displaces is a BRANCH, which the routine does not replay but
//     resolves with its two exits (0x00293BDC think, 0x00293BE4 the
//     light pass), and the slot is a `nop` that runs live.
patch=1,EE,00293BD4,word,08039800

// 40. sceneyaw -- Chatterbox's fall DRIFTED while turning. The other
//     half of section 34 (`scenevel`).
//
//     The symptom: `scenevel` already gives stock's LOCAL velocity, but
//     the integrator (0x0023F238) converts it to world space with the
//     physical root and only afterwards applies the interval's turn
//     (0x0023F4FC, section 7). On the second half step the root has
//     already turned half a delta, and an actor turning while it falls
//     went sideways.
//
//     This section replaces the `lq $a1, 0($s0)` that loads the
//     velocity. On the half step that lands on an integer, with
//     SceneAnim first in channel A at rate 1 and a delta and root of
//     pure yaw, it turns the velocity back by half a delta:
//     x' = w*x + z*y, y' = w*y - z*x, with (0, 0, z, w) = [s0+0x10],
//     the whole delta.
//
//     Guards: dt == 1/60 with live divider 1, the chain Human+0xD8 ->
//     channel A -> SceneAnim -> context, events enabled, the phase,
//     pure yaw and delta.w >= -0.5 (the large turn section 7 lets
//     through). It DEPENDS on `rootturn`, `rootphase` and `scenevel`.
//     It preserves the 128-bit $t0..$t2, $f4..$f9 and the FCR31. No
//     mutable state. The routine, in its cave:
//
//       0x000E6800  7A050000  lq    $a1, 0($s0)
//       0x000E6804  27BDFF80  addiu $sp, $sp, -128
//       0x000E6808  7FA50000  sq    $a1, 0($sp)
//       0x000E680C  7FA80010  sq    $t0, 16($sp)
//       0x000E6810  7FA90020  sq    $t1, 32($sp)
//       0x000E6814  7FAA0030  sq    $t2, 48($sp)
//       0x000E6818  E7A40040  swc1  $f4, 64($sp)
//       0x000E681C  E7A50044  swc1  $f5, 68($sp)
//       0x000E6820  E7A60048  swc1  $f6, 72($sp)
//       0x000E6824  E7A7004C  swc1  $f7, 76($sp)
//       0x000E6828  E7A80050  swc1  $f8, 80($sp)
//       0x000E682C  E7A90054  swc1  $f9, 84($sp)
//       0x000E6830  4448F800  cfc1  $t0, $f31
//       0x000E6834  AFA80058  sw    $t0, 88($sp)
//       0x000E6838  3C080051  lui   $t0, 0x0051
//       0x000E683C  350802CC  ori   $t0, $t0, 716
//       0x000E6840  8D080000  lw    $t0, 0($t0)
//       0x000E6844  3C093C88  lui   $t1, 0x3C88
//       0x000E6848  35298889  ori   $t1, $t1, -30583
//       0x000E684C  15090058  bne   $t0, $t1, 0x000E69B0
//       0x000E6850  00000000  nop
//       0x000E6854  3C080059  lui   $t0, 0x0059
//       0x000E6858  35086D70  ori   $t0, $t0, 28016
//       0x000E685C  91080000  lbu   $t0, 0($t0)
//       0x000E6860  3C090000  lui   $t1, 0x0000
//       0x000E6864  35290001  ori   $t1, $t1, 1
//       0x000E6868  15090051  bne   $t0, $t1, 0x000E69B0
//       0x000E686C  00000000  nop
//       0x000E6870  8E2800D8  lw    $t0, 216($s1)
//       0x000E6874  1100004E  beq   $t0, $zero, 0x000E69B0
//       0x000E6878  00000000  nop
//       0x000E687C  950902AC  lhu   $t1, 684($t0)
//       0x000E6880  1120004B  beq   $t1, $zero, 0x000E69B0
//       0x000E6884  00000000  nop
//       0x000E6888  8D0802BC  lw    $t0, 700($t0)
//       0x000E688C  11000048  beq   $t0, $zero, 0x000E69B0
//       0x000E6890  00000000  nop
//       0x000E6894  8D090000  lw    $t1, 0($t0)
//       0x000E6898  3C0A0053  lui   $t2, 0x0053
//       0x000E689C  354A4D58  ori   $t2, $t2, 19800
//       0x000E68A0  152A0043  bne   $t1, $t2, 0x000E69B0
//       0x000E68A4  00000000  nop
//       0x000E68A8  8D09000C  lw    $t1, 12($t0)
//       0x000E68AC  3C0A3F80  lui   $t2, 0x3F80
//       0x000E68B0  354A0000  ori   $t2, $t2, 0
//       0x000E68B4  152A003E  bne   $t1, $t2, 0x000E69B0
//       0x000E68B8  00000000  nop
//       0x000E68BC  8D080018  lw    $t0, 24($t0)
//       0x000E68C0  1100003B  beq   $t0, $zero, 0x000E69B0
//       0x000E68C4  00000000  nop
//       0x000E68C8  9509001E  lhu   $t1, 30($t0)
//       0x000E68CC  31298010  andi  $t1, $t1, -32752
//       0x000E68D0  15200037  bne   $t1, $zero, 0x000E69B0
//       0x000E68D4  00000000  nop
//       0x000E68D8  C5040018  lwc1  $f4, 24($t0)
//       0x000E68DC  3C0941F0  lui   $t1, 0x41F0
//       0x000E68E0  35290000  ori   $t1, $t1, 0
//       0x000E68E4  44892800  mtc1  $t1, $f5
//       0x000E68E8  46052102  mul.s $f4, $f4, $f5
//       0x000E68EC  9509001C  lhu   $t1, 28($t0)

// 27. trackphase -- the cursor of the SCENE TRACKS, the TWIN of the one
//     in section 26.
//
//     0x003560A8 is an exact twin of 0x001044A0: the same
//     trunc((t + dt)*30 + 0.5), another accumulator ([s1+0x10]) and
//     another length ([v0+4]). What it advances are the scene's
//     TRACKS -- the camera and the objects -- which are a different
//     system from the skeletal animation context of section 26.
//
//     Measured on a Cowboy scene: that clip's camera ran 1/30 s AHEAD
//     of the actor's clock (actor time 0.5 against 0.5333328 for the
//     track). In stock they were aligned.
//
//     The same 0.25 subtraction as scenephase, with the same two guards:
//
//       if $ra_of_0x003560A8 in {0x0039CF64, 0x0039D06C, 0x0039D158}
//          and [0x005102CC] == 1/60:   arg -= 0.25
//
//     The three return addresses are the track callers of THAT scene
//     Update -- the camera and the two object collections -- all three
//     with jal 0x003560A8 eight bytes before. The routine takes the
//     return address from the sd $ra, 0($sp) the twin does at
//     0x003560D0.
//
//     It does NOT touch the DURATION converter (0x003560F0) or its lui
//     at 0x003560E0, and its delay slot (0x0035610C) is not touched
//     either: it runs anyway and is the +0.5 the routine takes 0.25
//     from.
//
//       0x000E2800  27BDFFD0  addiu $sp, $sp, -48
//       0x000E2804  7FA80000  sq    $t0, 0($sp)
//       0x000E2808  7FA90010  sq    $t1, 16($sp)
//       0x000E280C  E7AD0020  swc1  $f13, 32($sp)
//       0x000E2810  8FA80030  lw    $t0, 48($sp)
//       0x000E2814  3C090039  lui   $t1, 0x0039
//       0x000E2818  3529CF64  ori   $t1, $t1, -12444
//       0x000E281C  1109000B  beq   $t0, $t1, 0x000E284C
//       0x000E2820  00000000  nop
//       0x000E2824  3C090039  lui   $t1, 0x0039
//       0x000E2828  3529D06C  ori   $t1, $t1, -12180
//       0x000E282C  11090007  beq   $t0, $t1, 0x000E284C
//       0x000E2830  00000000  nop
//       0x000E2834  3C090039  lui   $t1, 0x0039
//       0x000E2838  3529D158  ori   $t1, $t1, -11944
//       0x000E283C  11090003  beq   $t0, $t1, 0x000E284C
//       0x000E2840  00000000  nop
//       0x000E2844  1000000D  beq   $zero, $zero, 0x000E287C
//       0x000E2848  00000000  nop
//       0x000E284C  3C080051  lui   $t0, 0x0051
//       0x000E2850  350802CC  ori   $t0, $t0, 716
//       0x000E2854  8D080000  lw    $t0, 0($t0)
//       0x000E2858  3C093C88  lui   $t1, 0x3C88
//       0x000E285C  35298889  ori   $t1, $t1, -30583
//       0x000E2860  15090006  bne   $t0, $t1, 0x000E287C
//       0x000E2864  00000000  nop
//       0x000E2868  3C083E80  lui   $t0, 0x3E80
//       0x000E286C  35080000  ori   $t0, $t0, 0
//       0x000E2870  44886800  mtc1  $t0, $f13
//       0x000E2874  00000000  nop
//       0x000E2878  460D6301  sub.s $f12, $f12, $f13
//       0x000E287C  C7AD0020  lwc1  $f13, 32($sp)
//       0x000E2880  7BA80000  lq    $t0, 0($sp)
//       0x000E2884  7BA90010  lq    $t1, 16($sp)
//       0x000E2888  27BD0030  addiu $sp, $sp, 48
//       0x000E288C  0810B1C6  j     0x0042C718
//       0x000E2890  00000000  nop
//
patch=1,EE,000E2800,word,27BDFFD0
patch=1,EE,000E2804,word,7FA80000
patch=1,EE,000E2808,word,7FA90010
patch=1,EE,000E280C,word,E7AD0020

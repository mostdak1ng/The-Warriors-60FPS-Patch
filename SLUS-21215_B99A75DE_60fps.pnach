//
//     and the thunk that sends the GATE to the mirror as well: the
//     function is gated with just_released, and redirecting only the
//     walk leaves the trigger tied to a 60 fps edge -- it keeps
//     varying. The call is redirected, not 0x00144BA8, which is the
//     global accessor and must keep seeing the real ring.
//
patch=1,EE,000F19D0,word,080512EA
patch=1,EE,000F19D4,word,2484A600
//
patch=1,EE,00145094,word,0803C720
patch=1,EE,00145098,word,00000000
//
//     and the classifier: the stock code with TWO words changed.
//
patch=1,EE,00144D6C,word,2490A600
patch=1,EE,00144D74,word,0C03C674

// 10. meleewinr1 -- the hit window lasts as long as it does in stock.
//     The counter drops by one per collision pass, and at 60 fps that
//     is 100 ms instead of 233: it closed before the weapon finished
//     the swing.
//
//     It counts down on odd frames -- the same grid the sweep below
//     tests. Tying it to what the sweep publishes does not work: the
//     sweep does NOT run against people, so in a fight the window
//     would depend on whatever RAM held from the last hit on an
//     object, which always leaves it on the wrong branch.
//
patch=1,EE,000F1D00,word,3C010051
patch=1,EE,000F1D04,word,8C21C654
patch=1,EE,000F1D08,word,8E6200D0
patch=1,EE,000F1D0C,word,30210001

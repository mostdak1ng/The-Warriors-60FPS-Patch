//
//     and only now the hook: it lands on a `jal`, so it is a `jal`
//     ($ra = 0x00147CD8, where the classifier returns) and goes WITHOUT
//     its delay slot: the `lhu $a2, 10($s0)` is the second button, the
//     argument the routine reads.
patch=1,EE,00147CD0,word,0C03A500

// 48. grapplechord -- the STRONG GRAPPLE with X + O: with X held and O
//     just after, the grab (action 35) has to come out.
//
//     The symptom: `chord30` (section 22) also decides O + X on the EVEN
//     grid of the ring, at 30 Hz, and the X alone comes out at 60 from
//     another table and overrides the chord. With the cursor odd the
//     chord arrived a tick late and the X won: 3 of 6 phases at 67 ms,
//     against stock's 6 of 6.
//
//     The same shape as section 47, on the OTHER chord classifier
//     (0x00144EF8, the table of O + X, L1 + R1 and Select): it hooks its
//     ONLY caller and, only for O + X with dt 1/60 and live divider 1,
//     decides with the CURRENT sample and the one two back. Everything
//     else goes on through a `j` to `chord30`'s classifier, which is not
//     touched. No stack, no memory and no state. The routine, in its
//     cave:
//
//       0x000E9800  24A2FFE0  addiu $v0, $a1, -32
//       0x000E9804  14400025  bne   $v0, $zero, 0x000E989C
//       0x000E9808  00000000  nop
//       0x000E980C  24C2FFC0  addiu $v0, $a2, -64
//       0x000E9810  14400022  bne   $v0, $zero, 0x000E989C
//       0x000E9814  00000000  nop
//       0x000E9818  3C020051  lui   $v0, 0x0051
//       0x000E981C  344202CC  ori   $v0, $v0, 716
//       0x000E9820  8C420000  lw    $v0, 0($v0)
//       0x000E9824  3C033C88  lui   $v1, 0x3C88
//       0x000E9828  34638889  ori   $v1, $v1, -30583
//       0x000E982C  1443001B  bne   $v0, $v1, 0x000E989C
//       0x000E9830  00000000  nop
//       0x000E9834  3C020059  lui   $v0, 0x0059
//       0x000E9838  34426D70  ori   $v0, $v0, 28016
//       0x000E983C  90420000  lbu   $v0, 0($v0)
//       0x000E9840  24030001  addiu $v1, $zero, 1
//       0x000E9844  14430015  bne   $v0, $v1, 0x000E989C
//       0x000E9848  00000000  nop
//       0x000E984C  00A62825  or    $a1, $a1, $a2
//       0x000E9850  2486001C  addiu $a2, $a0, 28
//       0x000E9854  8C84002C  lw    $a0, 44($a0)
//       0x000E9858  00041040  sll   $v0, $a0, 1
//       0x000E985C  00C21021  addu  $v0, $a2, $v0
//       0x000E9860  94430000  lhu   $v1, 0($v0)
//       0x000E9864  00651824  and   $v1, $v1, $a1
//       0x000E9868  10A30003  beq   $a1, $v1, 0x000E9878
//       0x000E986C  2483FFFE  addiu $v1, $a0, -2
//       0x000E9870  03E00008  jr    $ra
//       0x000E9874  0000102D  daddu $v0, $zero, $zero
//       0x000E9878  30630007  andi  $v1, $v1, 7
//       0x000E987C  00031840  sll   $v1, $v1, 1
//       0x000E9880  00C31821  addu  $v1, $a2, $v1
//       0x000E9884  94620000  lhu   $v0, 0($v1)
//       0x000E9888  00451024  and   $v0, $v0, $a1
//       0x000E988C  00A21026  xor   $v0, $a1, $v0
//       0x000E9890  03E00008  jr    $ra
//       0x000E9894  0002102B  sltu  $v0, $zero, $v0
//       0x000E9898  00000000  nop
//       0x000E989C  080513BE  j     0x00144EF8
//       0x000E98A0  00000000  nop
//
patch=1,EE,000E9800,word,24A2FFE0
patch=1,EE,000E9804,word,14400025

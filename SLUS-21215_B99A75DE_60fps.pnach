//
//     and only now the hook, a `j` WITHOUT its delay slot: the
//     `mfc1 $a3, $f12` runs live before the jump. The routine replays
//     the `daddu $v0, $a0, $zero` at the end and returns to 0x00336C00.
patch=1,EE,00336BF8,word,0803B800

// 60. tagrate -- the spray-can TAG, faster and stricter (Rembrandt at
//     the first All-City tag): the cursor went 11% faster, leaving the
//     line penalised in half the time and, with "Input lag: STOCK", the
//     stick responded late.
//
//     The minigame (0x002748A8) advances by the ms of the CNS clock
//     since the previous update, with a cap of 30 per update that does
//     not bite at 60 fps; it counts the updates off the line and
//     penalises at 5, which at 60 is half the time; and it reads the
//     stick already delayed by section 49's queue.
//
//     Three hooks, ONLY at normal 60 fps (divider 1, dt 1/60): the cap
//     becomes 15 ms per update; the penalty, 10 errors; and, with Input
//     lag: STOCK, the tag reads the previous RAW sample of that queue,
//     through the pad's LUT (the dead zone and the rest stay native).
//     The global queue and the buttons are not touched. It depends on
//     section 49. It preserves the 128-bit $t0-$t2; no state. The three
//     routines, in their caves:
//
//       0x000EE800  00441023  subu  $v0, $v0, $a0
//       0x000EE804  27BDFFE0  addiu $sp, $sp, -32
//       0x000EE808  7FA80000  sq    $t0, 0($sp)
//       0x000EE80C  7FA90010  sq    $t1, 16($sp)
//       0x000EE810  3C080059  lui   $t0, 0x0059
//       0x000EE814  35086D70  ori   $t0, $t0, 28016
//       0x000EE818  91080000  lbu   $t0, 0($t0)
//       0x000EE81C  24090001  addiu $t1, $zero, 1
//       0x000EE820  1509000C  bne   $t0, $t1, 0x000EE854
//       0x000EE824  00000000  nop
//       0x000EE828  3C080051  lui   $t0, 0x0051
//       0x000EE82C  350802CC  ori   $t0, $t0, 716
//       0x000EE830  8D080000  lw    $t0, 0($t0)
//       0x000EE834  3C093C88  lui   $t1, 0x3C88
//       0x000EE838  35298889  ori   $t1, $t1, -30583
//       0x000EE83C  15090005  bne   $t0, $t1, 0x000EE854
//       0x000EE840  00000000  nop
//       0x000EE844  2C48000F  sltiu $t0, $v0, 15
//       0x000EE848  15000002  bne   $t0, $zero, 0x000EE854
//       0x000EE84C  00000000  nop
//       0x000EE850  2402000F  addiu $v0, $zero, 15
//       0x000EE854  2C43001E  sltiu $v1, $v0, 30
//       0x000EE858  7BA80000  lq    $t0, 0($sp)
//       0x000EE85C  7BA90010  lq    $t1, 16($sp)
//       0x000EE860  27BD0020  addiu $sp, $sp, 32
//       0x000EE864  0809D2A1  j     0x00274A84
//       0x000EE868  00000000  nop
//       0x000EE900  8E020510  lw    $v0, 1296($s0)
//       0x000EE904  27BDFFE0  addiu $sp, $sp, -32
//       0x000EE908  7FA80000  sq    $t0, 0($sp)
//       0x000EE90C  7FA90010  sq    $t1, 16($sp)
//       0x000EE910  3C080059  lui   $t0, 0x0059
//       0x000EE914  35086D70  ori   $t0, $t0, 28016
//       0x000EE918  91080000  lbu   $t0, 0($t0)
//       0x000EE91C  24090001  addiu $t1, $zero, 1
//       0x000EE920  1509000B  bne   $t0, $t1, 0x000EE950
//       0x000EE924  00000000  nop
//       0x000EE928  3C080051  lui   $t0, 0x0051
//       0x000EE92C  350802CC  ori   $t0, $t0, 716
//       0x000EE930  8D080000  lw    $t0, 0($t0)
//       0x000EE934  3C093C88  lui   $t1, 0x3C88
//       0x000EE938  35298889  ori   $t1, $t1, -30583
//       0x000EE93C  15090004  bne   $t0, $t1, 0x000EE950
//       0x000EE940  00000000  nop
//       0x000EE944  2C42000A  sltiu $v0, $v0, 10
//       0x000EE948  10000002  beq   $zero, $zero, 0x000EE954
//       0x000EE94C  00000000  nop
//       0x000EE950  2C420005  sltiu $v0, $v0, 5
//       0x000EE954  7BA80000  lq    $t0, 0($sp)
//       0x000EE958  7BA90010  lq    $t1, 16($sp)
//       0x000EE95C  27BD0020  addiu $sp, $sp, 32
//       0x000EE960  0809D305  j     0x00274C14
//       0x000EE964  00000000  nop
//       0x000EEA00  C7A30010  lwc1  $f3, 16($sp)
//       0x000EEA04  27BDFFD0  addiu $sp, $sp, -48
//       0x000EEA08  7FA80000  sq    $t0, 0($sp)
//       0x000EEA0C  7FA90010  sq    $t1, 16($sp)
//       0x000EEA10  7FAA0020  sq    $t2, 32($sp)
//       0x000EEA14  3C080059  lui   $t0, 0x0059
//       0x000EEA18  35086D70  ori   $t0, $t0, 28016
//       0x000EEA1C  91080000  lbu   $t0, 0($t0)
//       0x000EEA20  24090001  addiu $t1, $zero, 1
//       0x000EEA24  15090038  bne   $t0, $t1, 0x000EEB08
//       0x000EEA28  00000000  nop
//       0x000EEA2C  3C080051  lui   $t0, 0x0051
//       0x000EEA30  350802CC  ori   $t0, $t0, 716
//       0x000EEA34  8D080000  lw    $t0, 0($t0)
//       0x000EEA38  3C093C88  lui   $t1, 0x3C88
//       0x000EEA3C  35298889  ori   $t1, $t1, -30583
//       0x000EEA40  15090031  bne   $t0, $t1, 0x000EEB08
//       0x000EEA44  00000000  nop
//       0x000EEA48  3C08000D  lui   $t0, 0x000D
//       0x000EEA4C  35089200  ori   $t0, $t0, -28160
//       0x000EEA50  8D080000  lw    $t0, 0($t0)
//       0x000EEA54  1500002C  bne   $t0, $zero, 0x000EEB08
//       0x000EEA58  00000000  nop
//       0x000EEA5C  924801B0  lbu   $t0, 432($s2)
//       0x000EEA60  2D090002  sltiu $t1, $t0, 2
//       0x000EEA64  11200028  beq   $t1, $zero, 0x000EEB08
//       0x000EEA68  00000000  nop
//       0x000EEA6C  00085200  sll   $t2, $t0, 8
//       0x000EEA70  3C08000D  lui   $t0, 0x000D
//       0x000EEA74  35089000  ori   $t0, $t0, -28672
//       0x000EEA78  01485021  addu  $t2, $t2, $t0
//       0x000EEA7C  8D480004  lw    $t0, 4($t2)
//       0x000EEA80  3C090000  lui   $t1, 0x0000
//       0x000EEA84  3529D006  ori   $t1, $t1, -12282
//       0x000EEA88  1509001F  bne   $t0, $t1, 0x000EEB08
//       0x000EEA8C  00000000  nop
//       0x000EEA90  8D48000C  lw    $t0, 12($t2)
//       0x000EEA94  3C090050  lui   $t1, 0x0050
//       0x000EEA98  3529C654  ori   $t1, $t1, -14764
//       0x000EEA9C  8D290000  lw    $t1, 0($t1)
//       0x000EEAA0  15090019  bne   $t0, $t1, 0x000EEB08
//       0x000EEAA4  00000000  nop
//       0x000EEAA8  8D480000  lw    $t0, 0($t2)
//       0x000EEAAC  2D090006  sltiu $t1, $t0, 6
//       0x000EEAB0  11200015  beq   $t1, $zero, 0x000EEB08
//       0x000EEAB4  00000000  nop
//       0x000EEAB8  25080004  addiu $t0, $t0, 4
//       0x000EEABC  2D090006  sltiu $t1, $t0, 6
//       0x000EEAC0  15200002  bne   $t1, $zero, 0x000EEACC
//       0x000EEAC4  00000000  nop
//       0x000EEAC8  2508FFFA  addiu $t0, $t0, -6
//       0x000EEACC  00084140  sll   $t0, $t0, 5
//       0x000EEAD0  01485021  addu  $t2, $t2, $t0
//       0x000EEAD4  91480020  lbu   $t0, 32($t2)
//       0x000EEAD8  91490021  lbu   $t1, 33($t2)
//       0x000EEADC  00084080  sll   $t0, $t0, 2
//       0x000EEAE0  00094880  sll   $t1, $t1, 2
//       0x000EEAE4  3C0A0050  lui   $t2, 0x0050
//       0x000EEAE8  354AB8D0  ori   $t2, $t2, -18224
//       0x000EEAEC  010A4021  addu  $t0, $t0, $t2
//       0x000EEAF0  012A4821  addu  $t1, $t1, $t2
//       0x000EEAF4  C5030000  lwc1  $f3, 0($t0)
//       0x000EEAF8  C5220000  lwc1  $f2, 0($t1)
//       0x000EEAFC  46001087  neg.s $f2, $f2
//       0x000EEB00  E7A30040  swc1  $f3, 64($sp)
//       0x000EEB04  E7A20044  swc1  $f2, 68($sp)
//       0x000EEB08  7BA80000  lq    $t0, 0($sp)

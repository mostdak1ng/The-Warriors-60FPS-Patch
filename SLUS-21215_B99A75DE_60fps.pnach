//
//     and only now the hook: the delay slot NOPed first -- the routine
//     replays the `sub.s` and the `div.s` -- and then the `j`. It
//     returns to 0x00355CEC, section 28's hook. 0x00355CE4 is also
//     where section 41 (`cutrot`) returns: its `j` lands on this
//     complete pair.
patch=1,EE,00355CE8,word,00000000
patch=1,EE,00355CE4,word,08039D00

// 43. eventsnap -- Fox's JUMP in the television shot. The long
//     cutscene, "This is bullshit, man".
//
//     The symptom: stock moves Fox at once in ONE tick, tied to an
//     absolute relocation (section 35's pair of 0x15/0x16 events).
//     Section 35 re-expresses the end correctly, but the resource's
//     pose already carries the jump, and at 60 fps the half step showed
//     half of it: a frame that stock does not have.
//
//     This section, at the ENTRY of the vector lerp 0x00336BB8 -- where
//     section 35 jumps to --, for SceneAnim's POSE channel (the caller
//     read from the stack): on the half step before the pair, if the
//     gap between the two already re-expressed ends is larger than
//     0.1 u and than 32 * (previous pose step^2 + (velocity/30)^2), it
//     leaves $f12 = 0 -- the lerp returns the old end -- and $f21 = the
//     cursor -- the 33 bone rotations as well. It is a discontinuity
//     heuristic, not a flag of the format. It DEPENDS on `scenerebase`,
//     `rootphase` and `scenevel`. It preserves $at and the 128-bit
//     $t0..$t5, $f0..$f5 and the FCR31. No mutable state. The routine,
//     in its cave:
//
//       0x000E7800  27BDFF60  addiu $sp, $sp, -160
//       0x000E7804  7FA10000  sq    $at, 0($sp)
//       0x000E7808  7FA80010  sq    $t0, 16($sp)
//       0x000E780C  7FA90020  sq    $t1, 32($sp)
//       0x000E7810  7FAA0030  sq    $t2, 48($sp)
//       0x000E7814  7FAB0040  sq    $t3, 64($sp)
//       0x000E7818  7FAC0050  sq    $t4, 80($sp)
//       0x000E781C  7FAD0060  sq    $t5, 96($sp)
//       0x000E7820  E7A00070  swc1  $f0, 112($sp)
//       0x000E7824  E7A10074  swc1  $f1, 116($sp)
//       0x000E7828  E7A20078  swc1  $f2, 120($sp)
//       0x000E782C  E7A3007C  swc1  $f3, 124($sp)
//       0x000E7830  E7A40080  swc1  $f4, 128($sp)
//       0x000E7834  E7A50084  swc1  $f5, 132($sp)
//       0x000E7838  4448F800  cfc1  $t0, $f31
//       0x000E783C  AFA80088  sw    $t0, 136($sp)
//       0x000E7840  03E0402D  daddu $t0, $ra, $zero
//       0x000E7844  3C090010  lui   $t1, 0x0010
//       0x000E7848  35294CD4  ori   $t1, $t1, 19668
//       0x000E784C  150900DB  bne   $t0, $t1, 0x000E7BBC
//       0x000E7850  00000000  nop
//       0x000E7854  8FA800D0  lw    $t0, 208($sp)

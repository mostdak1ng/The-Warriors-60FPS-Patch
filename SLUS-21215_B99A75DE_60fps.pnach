patch=1,EE,00134280,word,0C03D600

// 20. scenerate -- CUTSCENE and ON-RAILS CAMERAS at 60 Hz (they used
//     to look like 30 fps, with stretches at 30 between 60 fps ones).
//
//     The scene dispatcher is a TIMING WHEEL: 0x003A3588 drains one
//     slot per call and advances [task+4] = (idx+1)%256, and each scene
//     reinserts itself [scene+0x6E] slots ahead.
//
//     The wheel turns at 60 slots/s in BOTH configurations: in stock
//     it is the two substeps of the accumulator (0x003A2EA0) at 30 fps,
//     and with section 4 it is one substep at 60. And the scene of an
//     on-rails shot asks for 2 slots -- measured, the same in stock and
//     patched. So the scene system has always been 30 Hz and section 4
//     could not touch it: this is not a regression but an improvement
//     that does not happen on its own.
//
//     The fix: when a scene asks for 2 slots -- one 30 Hz tick -- give
//     it 1. The other delays (20, 28, 60...) are real durations and
//     the wheel did not change pace, so they stay. And speed is
//     preserved by itself: the scene computes its dt as
//     global_clock - last_seen (0x003A1688), so running twice as often
//     it receives 1/60 instead of 1/30.
//
//     Measured cold, from the same state: the transform of the live
//     camera goes from 0.50 to 1.00 new states per presented frame,
//     with the SAME number of frames (1197) and the SAME game clock
//     (14997 ms). And the heading, pose against pose paired by clock:
//     0.0004 maximum divergence against a noise floor of 0.386 degrees
//     identical in both.
//
patch=1,EE,000F2180,word,24080002
patch=1,EE,000F2184,word,14C80002
patch=1,EE,000F2188,word,00000000
patch=1,EE,000F218C,word,24060001
patch=1,EE,000F2190,word,080E8D1E
patch=1,EE,000F2194,word,00000000
patch=1,EE,003A3654,word,0C03C860

// 21. rootphase -- the ROOT ROTATION DELTA comes from the right
//     INTERVAL (odd animations with the character close to the floor).
//
//     Root motion and the skeleton COMPENSATE each other: the character
//     turns one way and the base bone the opposite way so that the
//     visible body follows a continuous path, and at 30 fps both parts
//     agree on the whole-number instants of the animation. At 60 fps
//     the skeleton interpolates towards the NEXT key while the root
//     rotation delta reader keeps reading the CURRENT one, and on the
//     half frames it is half a tick behind that compensation.
//
//     That is why rootturn, which divides the magnitude, does not solve
//     it: the defect is in which INTERVAL the delta comes from, not in
//     its magnitude or its parity. It goes together with rootturn
//     (section 7).
//
//     The routine replaces the key reader of the root rotation channel
//     at 0x00104F48 and picks the next key on the half frame:
//
//       ptr = [s4]
//       if u8[s3+0xB6] == 1 and (f32[s3+0x18]*30 - u16[s3+0x1C]) > 0.25:
//           ptr += 8
//
//     The 0.25 separates the half frames from the whole instants and
//     tolerates the floating-point error around them. It does NOT
//     advance the bones' shared cursors or touch their interpolation,
//     and it carries no heap pointers or anything tied to a character
//     or an instant: the game itself resolves $s3.
//
//     Measured anchored to the game clock, with an image metric, on a
//     cutscene where Rembrandt falls and two others:
//
//       Rembrandt, 459 transitions  12 jumps > 15 deg, max 88.78 -> 0, max 8.93
//       Cleon, early stretch        jumps of 25.37 and 26.85     -> max 1.253
//       Sanchez, 149 transitions    13 changes > 15, max 89.60   -> 4, max 20.60
//
//     The cave at 0x000E2000 sits below everything else and was
//     verified to be zero in several unrelated game states.
//
//     The hook takes TWO words: the second one is the delay slot
//     (lh $v1, 2($a0)), which the routine replays at the end with the
//     pointer already chosen, so here it is NOPed. Emitting only one
//     would leave that lh reading the uncorrected pointer.
//
//     The routine, disassembled (the patch lines below are the same
//     words):
//
//       0x000E2000  27BDFFD0  addiu $sp, $sp, -48
//       0x000E2004  7FA80000  sq    $t0, 0($sp)
//       0x000E2008  7FA90010  sq    $t1, 16($sp)
//       0x000E200C  E7A40020  swc1  $f4, 32($sp)
//       0x000E2010  E7A50024  swc1  $f5, 36($sp)
//       0x000E2014  E7A60028  swc1  $f6, 40($sp)
//       0x000E2018  8E840000  lw    $a0, 0($s4)
//       0x000E201C  926800B6  lbu   $t0, 182($s3)
//       0x000E2020  24090001  addiu $t1, $zero, 1
//       0x000E2024  1509000F  bne   $t0, $t1, 0x000E2064
//       0x000E2028  00000000  nop
//       0x000E202C  C6640018  lwc1  $f4, 24($s3)
//       0x000E2030  3C0841F0  lui   $t0, 0x41F0
//       0x000E2034  44882800  mtc1  $t0, $f5
//       0x000E2038  46052102  mul.s $f4, $f4, $f5
//       0x000E203C  9668001C  lhu   $t0, 28($s3)
//       0x000E2040  44882800  mtc1  $t0, $f5
//       0x000E2044  46802960  cvt.s.w $f5, $f5
//       0x000E2048  46052101  sub.s $f4, $f4, $f5
//       0x000E204C  3C083E80  lui   $t0, 0x3E80
//       0x000E2050  44883000  mtc1  $t0, $f6
//       0x000E2054  46043034  c.lt.s $f6, $f4
//       0x000E2058  45000002  bc1f   0x000E2064
//       0x000E205C  00000000  nop
//       0x000E2060  24840008  addiu $a0, $a0, 8
//       0x000E2064  C7A40020  lwc1  $f4, 32($sp)
//       0x000E2068  C7A50024  lwc1  $f5, 36($sp)
//       0x000E206C  C7A60028  lwc1  $f6, 40($sp)
//       0x000E2070  7BA80000  lq    $t0, 0($sp)
//       0x000E2074  7BA90010  lq    $t1, 16($sp)
//       0x000E2078  27BD0030  addiu $sp, $sp, 48
//       0x000E207C  84830002  lh    $v1, 2($a0)
//       0x000E2080  080413D4  j     0x00104F50
//       0x000E2084  00000000  nop
//
patch=1,EE,000E2000,word,27BDFFD0
patch=1,EE,000E2004,word,7FA80000
patch=1,EE,000E2008,word,7FA90010
patch=1,EE,000E200C,word,E7A40020

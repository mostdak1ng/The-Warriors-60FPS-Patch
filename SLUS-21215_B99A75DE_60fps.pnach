// 22. chord30 -- TWO-BUTTON CHORDS: the STRONG ATTACK (Square + X)
//     and the POWER MOVE (the same with an opponent grabbed). Without
//     this, both take twice the effort: the window for both buttons to
//     register is very short.
//
//     The melee code does not decide it: the pad input classifier
//     does. 0x00147940 walks nine tables of 12-byte entries, and in
//     TWO of them the fourth field is not a threshold but the SECOND
//     MASK. The two classifiers that receive it are these:
//
//       0x00144F48   X + SQUARE (state 34), L2+X, L2+SQUARE
//       0x00144EF8   CIRCLE + X (35), L1 + R1 (31), SELECT + direction
//
//     The chord needs both buttons to land in the SAME sample of the
//     pad ring, and a sample is one tick: 33 ms in stock and 17 at
//     60 fps. Hence the double effort: a window written in SAMPLES.
//
//     Looking two samples back instead of one gives back stock's 34 ms
//     of wall time, but the edges keep following the 60 Hz grid, and
//     then a quick Square, X sequence comes out as a Strong Attack
//     instead of a combo (with 17 ms between the presses stock gives
//     the combo). So the fix also applies `andi $a0, $a0, 6` to the
//     ring cursor, which clears its bit 0 and collapses samples 2k and
//     2k+1 into a single slot: the decision is taken on the 30 Hz
//     GRID, which is the sampler stock has. Same width and the same
//     probability as well. Two presses 17 ms apart fall into different
//     slots -- just like stock -- and come out as a combo; two
//     genuinely simultaneous ones still fall into the same one and give
//     the Strong Attack.
//
//     The instruction goes in by consuming the nop that follows the
//     routine, so all 20 words of each classifier are emitted rather
//     than a point patch: the whole body moves one place.
//
//     The X, X extension of the power move is not affected: measured,
//     identical in both configurations.
//
//     The two routines, disassembled (the patch lines are the same
//     words):
//
//       -- 0x00144EF8
//       0x00144EF8  00A62825  or    $a1, $a1, $a2
//       0x00144EFC  2486001C  addiu $a2, $a0, 28
//       0x00144F00  8C84002C  lw    $a0, 44($a0)
//       0x00144F04  30840006  andi  $a0, $a0, 6
//       0x00144F08  00041040  sll   $v0, $a0, 1
//       0x00144F0C  00C21021  addu  $v0, $a2, $v0
//       0x00144F10  94430000  lhu   $v1, 0($v0)
//       0x00144F14  00651824  and   $v1, $v1, $a1
//       0x00144F18  10A30003  beq   $a1, $v1, 0x00144F28
//       0x00144F1C  2483FFFE  addiu $v1, $a0, -2
//       0x00144F20  03E00008  jr    $ra
//       0x00144F24  0000102D  daddu $v0, $zero, $zero
//       0x00144F28  30630007  andi  $v1, $v1, 7
//       0x00144F2C  00031840  sll   $v1, $v1, 1
//       0x00144F30  00C31821  addu  $v1, $a2, $v1
//       0x00144F34  94620000  lhu   $v0, 0($v1)
//       0x00144F38  00451024  and   $v0, $v0, $a1
//       0x00144F3C  00A21026  xor   $v0, $a1, $v0
//       0x00144F40  03E00008  jr    $ra
//       0x00144F44  0002102B  sltu  $v0, $zero, $v0
//       -- 0x00144F48
//       0x00144F48  2487001C  addiu $a3, $a0, 28
//       0x00144F4C  00A62825  or    $a1, $a1, $a2
//       0x00144F50  8C84002C  lw    $a0, 44($a0)
//       0x00144F54  30840006  andi  $a0, $a0, 6
//       0x00144F58  00041040  sll   $v0, $a0, 1
//       0x00144F5C  00E21021  addu  $v0, $a3, $v0
//       0x00144F60  94430000  lhu   $v1, 0($v0)
//       0x00144F64  00651824  and   $v1, $v1, $a1
//       0x00144F68  10A30003  beq   $a1, $v1, 0x00144F78
//       0x00144F6C  2483FFFE  addiu $v1, $a0, -2
//       0x00144F70  03E00008  jr    $ra
//       0x00144F74  0000102D  daddu $v0, $zero, $zero
//       0x00144F78  30630007  andi  $v1, $v1, 7
//       0x00144F7C  00031840  sll   $v1, $v1, 1
//       0x00144F80  00E31821  addu  $v1, $a3, $v1
//       0x00144F84  94620000  lhu   $v0, 0($v1)
//       0x00144F88  00461024  and   $v0, $v0, $a2
//       0x00144F8C  00C21026  xor   $v0, $a2, $v0
//       0x00144F90  03E00008  jr    $ra
//       0x00144F94  0002102B  sltu  $v0, $zero, $v0
//
patch=1,EE,00144EF8,word,00A62825
patch=1,EE,00144EFC,word,2486001C
patch=1,EE,00144F00,word,8C84002C
patch=1,EE,00144F04,word,30840006
patch=1,EE,00144F08,word,00041040

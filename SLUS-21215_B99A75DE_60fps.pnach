// 59. poseorient -- the EXTRA TURN of the first bone in cutscenes. The
//     cop next to Ajax, Fox's struggle up to "We gotta go!" and Cowboy
//     lying down turned too far on the intermediate frame (up to 88
//     degrees on the frame before a cut).
//
//     On the half step, the actor's PHYSICAL root turns half of the
//     turn key (sections 7 and 21), but the rotation of the first bone
//     is interpolated separately between two ends that are each in the
//     frame of THEIR root. If root and skeleton turn in opposite
//     directions, the mix leaves a turn that does not exist. And on the
//     frame that section 36 holds before a cut, the root keeps turning
//     and the held pose does not.
//
//     This section hooks the entry of the quaternion nlerp (0x00336BF8)
//     and, ONLY on the first bone of a SceneAnim clip, at normal 60 fps,
//     on the half step of a one-tick key, with a root turn of pure yaw,
//     no event that changes the frame and a physical root without tilt,
//     brings both ends into the frame of the half-turned root (the old
//     one by the inverse of the half turn, the new one by it). On the
//     held pose, its XY too. It does not touch the physical root,
//     cameras or times. It depends on sections 7 and 21. It preserves
//     $at and the 128-bit $t0-$t4, $f0-$f9 and the FCR31; no state. The
//     routine, in its cave:
//
//       0x000EE000  27BDFF50  addiu $sp, $sp, -176
//       0x000EE004  7FA10000  sq    $at, 0($sp)
//       0x000EE008  7FA80010  sq    $t0, 16($sp)
//       0x000EE00C  7FA90020  sq    $t1, 32($sp)
//       0x000EE010  7FAA0030  sq    $t2, 48($sp)
//       0x000EE014  7FAB0040  sq    $t3, 64($sp)
//       0x000EE018  7FAC0050  sq    $t4, 80($sp)
//       0x000EE01C  E7A00060  swc1  $f0, 96($sp)
//       0x000EE020  E7A10064  swc1  $f1, 100($sp)
//       0x000EE024  E7A20068  swc1  $f2, 104($sp)
//       0x000EE028  E7A3006C  swc1  $f3, 108($sp)
//       0x000EE02C  E7A40070  swc1  $f4, 112($sp)
//       0x000EE030  E7A50074  swc1  $f5, 116($sp)
//       0x000EE034  E7A60078  swc1  $f6, 120($sp)
//       0x000EE038  E7A7007C  swc1  $f7, 124($sp)
//       0x000EE03C  E7A80080  swc1  $f8, 128($sp)
//       0x000EE040  E7A90084  swc1  $f9, 132($sp)
//       0x000EE044  4448F800  cfc1  $t0, $f31
//       0x000EE048  AFA80088  sw    $t0, 136($sp)
//       0x000EE04C  03E0402D  daddu $t0, $ra, $zero
//       0x000EE050  3C090010  lui   $t1, 0x0010
//       0x000EE054  35294BBC  ori   $t1, $t1, 19388
//       0x000EE058  150900FF  bne   $t0, $t1, 0x000EE458
//       0x000EE05C  00000000  nop
//       0x000EE060  8FA800F0  lw    $t0, 240($sp)
//       0x000EE064  3C090010  lui   $t1, 0x0010
//       0x000EE068  352950E0  ori   $t1, $t1, 20704
//       0x000EE06C  150900FA  bne   $t0, $t1, 0x000EE458
//       0x000EE070  00000000  nop
//       0x000EE074  8FA80140  lw    $t0, 320($sp)
//       0x000EE078  3C090010  lui   $t1, 0x0010
//       0x000EE07C  35296B7C  ori   $t1, $t1, 27516
//       0x000EE080  150900F5  bne   $t0, $t1, 0x000EE458

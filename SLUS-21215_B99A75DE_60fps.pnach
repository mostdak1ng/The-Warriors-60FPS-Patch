// 29. cutprop -- the OBJECT does not jump ahead of the cut. It comes
//     AFTER cutshift because it READS its marker (0x000E23F0) and does
//     not write it.
//
//     The symptom: Fox's knife separates from his body on the last
//     frame of the close-up in l80_c6_b. Fox is human 16; the knife is
//     dyn_hunter and HAS ITS OWN ENTITY TRACK -- it does not move by
//     copying the hand's matrix, which is what makes the defect
//     possible.
//
//     Its keys 161 and 162 carry a relocation of ~1.825 units ACROSS
//     the cut at time 162/30 = 5.4 s. Stock never shows it halfway
//     because the cut hides it; at 60 fps a half frame appears in the
//     middle. There were two chained defects there:
//
//       1. the cursor running ahead picked 161->162 while the previous
//          interval still applied and the factor came out ~-0.5: it
//          extrapolated BACKWARDS. trackphase (section 27) closes that;
//       2. with the cursor corrected the factor is ~0.5, which is an
//          interpolation CORRECT IN ARITHMETIC AND WRONG ON SCREEN: it
//          moves the knife 0.913 units towards its place in the next
//          shot while Fox is still in the previous one.
//
//     cutshift does not cause it: without cutshift the knife jumps
//     ahead just the same (Fox moves 0.039 units and the knife 0.913).
//
//     Measured, the knife's X (it carries most of the relocation; the
//     correction works in XYZ):
//
//       clip t       sample    Fox X        knife unfixed  with this
//       5.366642     37        -253.684784  -253.206680    -253.206680
//       5.383309     38        -253.684784  -252.294525    -253.206802
//       5.399975     39, cut   -251.785355  -251.382019    -251.382019
//
//     so the step before the cut drops from 0.912624 to 0.000123
//     units. The residue comes from evaluating the exact key against
//     the float time accumulated on the previous frame, not from an
//     error in this section.
//
//     The hook sits in the track's TRANSLATION interpolation
//     (0x00355AB8), AFTER the keys are resolved, and the only thing it
//     changes is the TIME used for the factor: it puts in the previous
//     key's ($f3), so 0x00355E34 computes f3 - f3 = 0 and the factor
//     comes out zero. It does not touch orientation, cursors, times or
//     the resource data: the knife's rotation stays as it was.
//
//     Five guards, and none of them names Fox, the knife, the scene or
//     the 5.4:
//
//       * the chain SceneUpdate -> TrackUpdate -> TrackEval: inner
//         return address 0x00356130 (0x00356128 is the jal to
//         0x00355AB8) and outer 0x0039D06C or 0x0039D158. Both are read
//         from the ORIGINAL stack positions [sp+0x50] and [sp+0x60],
//         counting the 0x50 bytes of the new frame: 0x00355AB8 reserves
//         96 and does sd $ra, 0x50($sp), and [sp+0x60] is the [sp+0] of
//         its caller -- the twin 0x003560A8 --, i.e. the SAME stack
//         word trackphase reads;
//       * [0x005102CC] == 1/60;
//       * cutshift's marker non-zero and == [0x005104F4] + 1, i.e.
//         exactly the half frame BEFORE the cut. On the frame of the cut
//         the original interpolation runs;
//       * adjacent keys: $a1 - $a0 == 1;
//       * and the gap to the next key in [1/120, 1/40), which picks the
//         interval that crosses that cut and does not freeze long
//         tracks whose first key is far away.
//
//     Controls: 55 samples with and without this section where the ONLY
//     different position is sample 38 -- the knife's rotation, the
//     door's track, the camera, the root pool and the 60 bone slots
//     are bit-for-bit identical --; the cop's cut of section 28 with
//     70 samples and 6 actors identical, keeping the root steps
//     0 / 0.494061 / 0; gameplay with 40 samples and 3 actors
//     identical; and a 50-sample stock control without changes.
//
//     The hook takes TWO words: the routine EXECUTES the first on entry
//     -- it needs that $f0 to compare -- and REPLAYS the second at the
//     end before returning to hook+8, so here it is NOPed.
//
//     The routine, disassembled:
//
//       0x000E2900  27BDFFB0  addiu $sp, $sp, -80
//       0x000E2904  7FA80000  sq    $t0, 0($sp)
//       0x000E2908  7FA90010  sq    $t1, 16($sp)
//       0x000E290C  7FAA0020  sq    $t2, 32($sp)
//       0x000E2910  7FAB0030  sq    $t3, 48($sp)
//       0x000E2914  E7AD0040  swc1  $f13, 64($sp)
//       0x000E2918  C4E00010  lwc1  $f0, 16($a3)
//       0x000E291C  8FA800A0  lw    $t0, 160($sp)
//       0x000E2920  3C090035  lui   $t1, 0x0035
//       0x000E2924  35296130  ori   $t1, $t1, 24880
//       0x000E2928  1509002E  bne   $t0, $t1, 0x000E29E4
//       0x000E292C  00000000  nop
//       0x000E2930  8FA800B0  lw    $t0, 176($sp)
//       0x000E2934  3C090039  lui   $t1, 0x0039
//       0x000E2938  3529D06C  ori   $t1, $t1, -12180
//       0x000E293C  11090005  beq   $t0, $t1, 0x000E2954
//       0x000E2940  00000000  nop
//       0x000E2944  3C090039  lui   $t1, 0x0039
//       0x000E2948  3529D158  ori   $t1, $t1, -11944
//       0x000E294C  15090025  bne   $t0, $t1, 0x000E29E4
//       0x000E2950  00000000  nop
//       0x000E2954  3C080051  lui   $t0, 0x0051
//       0x000E2958  350802CC  ori   $t0, $t0, 716
//       0x000E295C  8D080000  lw    $t0, 0($t0)
//       0x000E2960  3C093C88  lui   $t1, 0x3C88
//       0x000E2964  35298889  ori   $t1, $t1, -30583
//       0x000E2968  1509001E  bne   $t0, $t1, 0x000E29E4
//       0x000E296C  00000000  nop
//       0x000E2970  3C08000E  lui   $t0, 0x000E
//       0x000E2974  350823F0  ori   $t0, $t0, 9200
//       0x000E2978  8D080000  lw    $t0, 0($t0)
//       0x000E297C  11000019  beq   $t0, $zero, 0x000E29E4
//       0x000E2980  00000000  nop
//       0x000E2984  3C090051  lui   $t1, 0x0051
//       0x000E2988  352904F4  ori   $t1, $t1, 1268
//       0x000E298C  8D290000  lw    $t1, 0($t1)
//       0x000E2990  25290001  addiu $t1, $t1, 1
//       0x000E2994  15090013  bne   $t0, $t1, 0x000E29E4
//       0x000E2998  00000000  nop
//       0x000E299C  00A44023  subu  $t0, $a1, $a0
//       0x000E29A0  3C090000  lui   $t1, 0x0000
//       0x000E29A4  35290001  ori   $t1, $t1, 1
//       0x000E29A8  1509000E  bne   $t0, $t1, 0x000E29E4
//       0x000E29AC  00000000  nop
//       0x000E29B0  46002341  sub.s $f13, $f4, $f0
//       0x000E29B4  44086800  mfc1  $t0, $f13
//       0x000E29B8  3C093C08  lui   $t1, 0x3C08
//       0x000E29BC  35298889  ori   $t1, $t1, -30583
//       0x000E29C0  0109502B  sltu  $t2, $t0, $t1
//       0x000E29C4  15400007  bne   $t2, $zero, 0x000E29E4
//       0x000E29C8  00000000  nop
//       0x000E29CC  3C093CCC  lui   $t1, 0x3CCC
//       0x000E29D0  3529CCCD  ori   $t1, $t1, -13107
//       0x000E29D4  0109502B  sltu  $t2, $t0, $t1
//       0x000E29D8  11400002  beq   $t2, $zero, 0x000E29E4
//       0x000E29DC  00000000  nop
//       0x000E29E0  46001806  mov.s $f0, $f3
//       0x000E29E4  C7AD0040  lwc1  $f13, 64($sp)
//       0x000E29E8  7BA80000  lq    $t0, 0($sp)
//       0x000E29EC  7BA90010  lq    $t1, 16($sp)
//       0x000E29F0  7BAA0020  lq    $t2, 32($sp)
//       0x000E29F4  7BAB0030  lq    $t3, 48($sp)
//       0x000E29F8  27BD0050  addiu $sp, $sp, 80
//       0x000E29FC  46032041  sub.s $f1, $f4, $f3
//       0x000E2A00  080D578D  j     0x00355E34
//       0x000E2A04  00000000  nop
//
patch=1,EE,000E2900,word,27BDFFB0
patch=1,EE,000E2904,word,7FA80000
patch=1,EE,000E2908,word,7FA90010
patch=1,EE,000E290C,word,7FAA0020

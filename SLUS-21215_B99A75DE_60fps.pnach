//
//     and only now the hooks: each `j` BEFORE its slot as a `nop` (the
//     trampolines replay the `lui $v0`).
patch=1,EE,002856B8,word,0802C400
patch=1,EE,002856BC,word,00000000
patch=1,EE,00283A30,word,0802C600
patch=1,EE,00283A34,word,00000000

// 70. auto-off -- UNTICKING this patch returns the game to stock.
//     Unticking the patch in PCSX2 has to leave the session as stock,
//     without any separate tool. But a .pnach cannot 'detach': PCSX2
//     stops writing its lines and the code they already wrote stays in
//     RAM.
//
//     Section 53's hook (0x003A2EA0, the entry of the accumulator, once
//     per presented frame) jumps here. This routine watches a
//     HEARTBEAT: the word 0x000C0F00, which the `patch=1` line below
//     writes on every VSync while the patch is ticked. With a heartbeat
//     it clears it and goes on to section 53. With no heartbeat on two
//     entries in a row, the patch was unticked: it checks that each of
//     the 266 sites in the table holds either this file's word or the
//     game's, that the clock pointer is valid and that the global dt is
//     between 0 and 1/60; and only then writes the game's word into
//     each one (the .text every section touches and the two dividers),
//     sets the clock copy to 1/30 and doubles the global dt (a slow
//     motion stays slow, and 0 stays 0), and returns to the native
//     accumulator. If anything does not match it writes nothing and
//     carries on as if ticked (0x000C0F08 says why, 0x000C0F0C where).
//     The caves and section 68's history stay written but nothing calls
//     them; ticking the patch again rewrites everything.
//
//     The table is generated from the directives of THIS file and the
//     ELF. It preserves the 128-bit $t0-$t7.
//
//     The routine, the table (address, this file's word, the game's
//     word, width; it ends in four zeros), the heartbeat and the
//     control words (result, conflicting site and retirements), which
//     are zeroed ONLY at boot:
//
patch=1,EE,000C0000,word,27BDFF80
patch=1,EE,000C0004,word,7FA80000

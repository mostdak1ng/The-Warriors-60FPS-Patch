// 66. sprayrate -- the EFFECT of the spray attack ran at double speed
//     (Triangle + Circle with the spray can): the mist lasted half as
//     long as in stock.
//
//     The three emitters (sub_spr, 0x00514260) and the eighteen
//     particles (power_mist, 0x00513B1C) ask for wait 2 on section 20's
//     wheel and advance per invocation; section 20 turns every wait of
//     2 into 1. It is the same thing section 56 (flamewait) corrects for
//     fire, and the hook is its continuation: the return of its
//     routine, 0x003A3480. It puts the wait back to 2 ONLY if: it comes
//     from the dispatcher (return address 0x003A365C), the wait is 1,
//     the live divider is 1, dt is exactly 1/60, the object is of one of
//     those two classes (vtable and definition) and its request was 2.
//     No dependencies: without section 20 it does nothing. It preserves
//     the 128-bit $t0-$t1; no state. The routine, in its cave:
//
//       0x000F5C00  27BDFFE0  addiu $sp, $sp, -32
//       0x000F5C04  7FA80000  sq    $t0, 0($sp)
//       0x000F5C08  7FA90010  sq    $t1, 16($sp)
//       0x000F5C0C  3C08003A  lui   $t0, 0x003A
//       0x000F5C10  3508365C  ori   $t0, $t0, 13916
//       0x000F5C14  17E80023  bne   $ra, $t0, 0x000F5CA4
//       0x000F5C18  00000000  nop
//       0x000F5C1C  24080001  addiu $t0, $zero, 1
//       0x000F5C20  14C80020  bne   $a2, $t0, 0x000F5CA4
//       0x000F5C24  00000000  nop
//       0x000F5C28  3C090059  lui   $t1, 0x0059
//       0x000F5C2C  35296D70  ori   $t1, $t1, 28016
//       0x000F5C30  91290000  lbu   $t1, 0($t1)
//       0x000F5C34  1528001B  bne   $t1, $t0, 0x000F5CA4
//       0x000F5C38  00000000  nop
//       0x000F5C3C  3C080051  lui   $t0, 0x0051
//       0x000F5C40  350802CC  ori   $t0, $t0, 716
//       0x000F5C44  8D080000  lw    $t0, 0($t0)
//       0x000F5C48  3C093C88  lui   $t1, 0x3C88
//       0x000F5C4C  35298889  ori   $t1, $t1, -30583
//       0x000F5C50  15090014  bne   $t0, $t1, 0x000F5CA4
//       0x000F5C54  00000000  nop
//       0x000F5C58  8CA80000  lw    $t0, 0($a1)
//       0x000F5C5C  3C090054  lui   $t1, 0x0054
//       0x000F5C60  35295660  ori   $t1, $t1, 22112
//       0x000F5C64  1509000F  bne   $t0, $t1, 0x000F5CA4
//       0x000F5C68  00000000  nop
//       0x000F5C6C  94A8006E  lhu   $t0, 110($a1)
//       0x000F5C70  24090002  addiu $t1, $zero, 2
//       0x000F5C74  1509000B  bne   $t0, $t1, 0x000F5CA4
//       0x000F5C78  00000000  nop
//       0x000F5C7C  8CA800E0  lw    $t0, 224($a1)
//       0x000F5C80  3C090051  lui   $t1, 0x0051
//       0x000F5C84  35293B1C  ori   $t1, $t1, 15132
//       0x000F5C88  11090005  beq   $t0, $t1, 0x000F5CA0
//       0x000F5C8C  00000000  nop
//       0x000F5C90  3C090051  lui   $t1, 0x0051
//       0x000F5C94  35294260  ori   $t1, $t1, 16992
//       0x000F5C98  15090002  bne   $t0, $t1, 0x000F5CA4
//       0x000F5C9C  00000000  nop
//       0x000F5CA0  24060002  addiu $a2, $zero, 2
//       0x000F5CA4  7BA80000  lq    $t0, 0($sp)
//       0x000F5CA8  7BA90010  lq    $t1, 16($sp)
//       0x000F5CAC  27BD0020  addiu $sp, $sp, 32
//       0x000F5CB0  24840008  addiu $a0, $a0, 8
//       0x000F5CB4  00E63821  addu  $a3, $a3, $a2
//       0x000F5CB8  080E8D22  j     0x003A3488
//       0x000F5CBC  00000000  nop
//
patch=1,EE,000F5C00,word,27BDFFE0
patch=1,EE,000F5C04,word,7FA80000
patch=1,EE,000F5C08,word,7FA90010
patch=1,EE,000F5C0C,word,3C08003A
patch=1,EE,000F5C10,word,3508365C
patch=1,EE,000F5C14,word,17E80023
patch=1,EE,000F5C18,word,00000000

//
//     and only now the hook: `j` to the cave over the BRANCH, with the
//     delay slot as a `nop` (the routine resolves the branch with two
//     exits and replays the `lw` on both).
patch=1,EE,00147CD8,word,0803D740
patch=1,EE,00147CDC,word,00000000

// 68. radiorate -- the car RADIO, at the native cadence (stealing a
//     radio with Rembrandt or Ajax, turning the stick): with Input lag:
//     STOCK the turn responded about 117 ms late, the pause between
//     screws lasted 250 ms instead of 267 and the vibration came out in
//     another proportion.
//
//     The radio adds up the turn between this tick's stick sample and
//     the previous one, and at 60 fps there are two ticks for each one
//     of stock. This section, ONLY at normal 60 fps: a capture of the
//     camera matrix before the pad updater; and a wrapper around the
//     radio that takes the RECENT stick sample (with Input lag: STOCK,
//     the last raw one from section 49's queue, through the native
//     transform with that matrix; with OFF, the pad's), evaluates the
//     native mechanics on even frames with the 30 Hz pair from a
//     history of its own, restores it afterwards, and on odd frames
//     draws the HUD and checks for cancellation. A change of player or
//     target, or a jump in frames, resets the history. It depends on
//     section 49. It preserves the 128-bit $s0-$s5, $ra and $f20/$f21.
//
//     The HISTORY (two 0x100 areas, one per controller) is zeroed ONCE
//     at boot and NEVER with patch=1: doing it every frame would erase
//     the previous turn. Zero means 'no history', which is also how a
//     save state made without the patch starts.
patch=0,EE,000FE000,word,00000000
patch=0,EE,000FE004,word,00000000
patch=0,EE,000FE008,word,00000000
patch=0,EE,000FE00C,word,00000000
patch=0,EE,000FE010,word,00000000

patch=1,EE,00104EC0,word,0C038AC0

// 31. buttonrate -- the BUTTON-TAP of the CHASES: Encore and the
//     endings of Desperate Dudes and Come Out to Play.
//
//     The symptom: mashing X at about 9 presses per second the game
//     RECOGNISES practically the same cadence as stock -- 8.99 against
//     8.98 Hz, measured -- but the character LOSES SPEED and falls
//     short of finishing the chase. So the defect is NOT in detection:
//     the X is seen just as well.
//
//     It is NOT the accumulator minigame that mashsplit and mashhold
//     correct: it is another system and they do not share a single
//     hook. The Lua of these levels calls HuSetButtonTapControl, which
//     installs the handler 0x00242CE0 on the human. That handler asks
//     0x00147EF8 for the command of the control descriptor and looks
//     for 45 decimal / 0x2D, which is the press -- not the raw X bit or
//     a Lua command code.
//
//     Stock, at 0x00243138..0x00243174:
//
//       if command == 45:  interval = wait;  wait = 0
//       else:              wait += 1
//       if wait >= 11:     interval = wait = 10
//       target = vmax * (1 - clamp((interval - 2) / 8, 0, 1))
//
//     with Human+0x670 the interval of the last press and Human+0x674
//     the updates without a press since the previous one; both are
//     zeroed when the control is installed (0x002445F8). vmax comes
//     from 0x002216C0 and is NOT an Encore constant, which is why this
//     applies to any level that installs this control -- all three
//     chases do. If the speed is below the target it rises at once;
//     when it has to drop, the branch at 0x00243230 applies
//     speed -= (speed - target) / 30 ON EVERY UPDATE.
//
//     At 60 Hz the same physical cadence leaves TWICE as many updates
//     between presses, the handler reads that number on the 30 Hz
//     scale and asks for less speed; and on top of that the smoothing
//     runs twice as often per second. Both halves push the same way,
//     which is why this section has two blocks.
//
//     FIRST BLOCK, the counter. It keeps STOCK'S TIME GRID: +0x674 still
//     counts updates of the current simulation, and when the press
//     arrives that interval is converted to the 30 Hz grid with the
//     world substep counter T = [0x005104F4]:
//
//       N = updates without a press    D = N + 1
//       interval = floor(T/2) - floor((T-D)/2) - 1
//                = floor((N - (T & 1)) / 2)
//       interval = max(interval, 0)
//
//     i.e. the distance between the DATES of the two presses on one
//     grid, in whole stock units. A continuous conversion
//     ((N+1)/2)-1 -- rounding each duration separately -- passes at
//     9 Hz and FAILS at 6.47 Hz, where stock completes: the handler's
//     response is asymmetric, it alternates discrete targets and the
//     peaks accelerate immediately, and a continuous average does not
//     reproduce that dynamic.
//
//     The wait without presses goes from 11 updates at 30 Hz to 22 at
//     60, and when it expires it saturates +0x674 at 21 and +0x670 at
//     10, which is stock's zero target. THE SPEED FORMULA IS NOT
//     TOUCHED, nor its asymmetry: the block returns to 0x00243178,
//     right before it.
//
//     SECOND BLOCK, the smoothing. Its constant is NOT half of stock's:
//     two 60 Hz updates with the same target have to decay as much as
//     one stock update, so (1 - alpha60)^2 = 1 - 1/30, i.e.
//     alpha60 = 1 - sqrt(29/30) = 0.016807919 (0x3C89B0C3). The stock
//     branch keeps using 1/30.
//
//     Both halves compare [0x005102CC] against 1/60 and are INERT
//     otherwise, reproducing exactly what stock did. At 30 fps nothing
//     changes.
//
//     BOTH DELAY SLOTS ARE EMITTED, NOPed, unlike the cursor ones:
//     neither hook lands on a jal, both displace TWO instructions and
//     the routines replay them. The counter's is not optional -- what
//     it displaces is a branch, and a branch in a delay slot is
//     undefined.
//
//     Measured with input built on the GAME CLOCK, not host time, and
//     with all three configurations started from the same instant:
//
//       Encore, 9 Hz        stock 13.620089 s   completes
//                           without this        DIES, HP reaches 1
//                           with this           13.658860 s (+0.285%)
//       Encore, 6.47 Hz     stock 15.647455 s   completes
//                           with this           15.645259 s (-0.014%)
//       Desperate Dudes 9   stock 15.468407 s   completes
//                           without this        DIES, HP reaches 1
//                           with this           15.456125 s
//
//     and the mean horizontal speed between seconds 2 and 3 of Encore
//     at 9 Hz: 11.9496 stock / 7.2986 without this / 11.9719 with it.
//
//     The counter, disassembled:
//
//       0x000E2C00  27BDFFD0  addiu $sp, $sp, -48
//       0x000E2C04  7FA80000  sq    $t0, 0($sp)
//       0x000E2C08  7FA90010  sq    $t1, 16($sp)
//       0x000E2C0C  7FAA0020  sq    $t2, 32($sp)
//       0x000E2C10  3C080051  lui   $t0, 0x0051
//       0x000E2C14  350802CC  ori   $t0, $t0, 716
//       0x000E2C18  8D080000  lw    $t0, 0($t0)
//       0x000E2C1C  3C093C88  lui   $t1, 0x3C88
//       0x000E2C20  35298889  ori   $t1, $t1, -30583
//       0x000E2C24  01095026  xor   $t2, $t0, $t1
//       0x000E2C28  2D4A0001  sltiu $t2, $t2, 1
//       0x000E2C2C  2409000A  addiu $t1, $zero, 10
//       0x000E2C30  11400002  beq   $t2, $zero, 0x000E2C3C
//       0x000E2C34  00000000  nop
//       0x000E2C38  24090015  addiu $t1, $zero, 21
//       0x000E2C3C  2403002D  addiu $v1, $zero, 45
//       0x000E2C40  14430011  bne   $v0, $v1, 0x000E2C88
//       0x000E2C44  00000000  nop
//       0x000E2C48  8E020674  lw    $v0, 1652($s0)
//       0x000E2C4C  AE000674  sw    $zero, 1652($s0)
//       0x000E2C50  1140000A  beq   $t2, $zero, 0x000E2C7C
//       0x000E2C54  00000000  nop
//       0x000E2C58  3C080051  lui   $t0, 0x0051
//       0x000E2C5C  350804F4  ori   $t0, $t0, 1268
//       0x000E2C60  8D080000  lw    $t0, 0($t0)
//       0x000E2C64  31080001  andi  $t0, $t0, 1
//       0x000E2C68  00481023  subu  $v0, $v0, $t0
//       0x000E2C6C  00021043  sra   $v0, $v0, 1
//       0x000E2C70  04410002  bgez  $v0, 0x000E2C7C
//       0x000E2C74  00000000  nop
//       0x000E2C78  24020000  addiu $v0, $zero, 0
//       0x000E2C7C  AE020670  sw    $v0, 1648($s0)
//       0x000E2C80  10000004  beq   $zero, $zero, 0x000E2C94
//       0x000E2C84  00000000  nop
//       0x000E2C88  8E020674  lw    $v0, 1652($s0)
//       0x000E2C8C  24420001  addiu $v0, $v0, 1
//       0x000E2C90  AE020674  sw    $v0, 1652($s0)
//       0x000E2C94  8E020674  lw    $v0, 1652($s0)
//       0x000E2C98  0122402A  slt   $t0, $t1, $v0
//       0x000E2C9C  11000004  beq   $t0, $zero, 0x000E2CB0
//       0x000E2CA0  00000000  nop
//       0x000E2CA4  AE090674  sw    $t1, 1652($s0)
//       0x000E2CA8  2402000A  addiu $v0, $zero, 10
//       0x000E2CAC  AE020670  sw    $v0, 1648($s0)
//       0x000E2CB0  8E020670  lw    $v0, 1648($s0)
//       0x000E2CB4  7BA80000  lq    $t0, 0($sp)
//       0x000E2CB8  7BA90010  lq    $t1, 16($sp)
//       0x000E2CBC  7BAA0020  lq    $t2, 32($sp)
//       0x000E2CC0  27BD0030  addiu $sp, $sp, 48
//       0x000E2CC4  08090C5E  j     0x00243178
//       0x000E2CC8  00000000  nop
//
patch=1,EE,000E2C00,word,27BDFFD0

//
//     and only now the hook, a `j` WITHOUT its delay slot: what it
//     displaces is a BRANCH, which the routine does not replay but
//     resolves with its two exits (0x00355CDC without a cut, 0x00355CEC
//     with a cut), and the slot is a `nop` that runs live. Both branches
//     of the native detector also reach the hook, and land on this `j`.
patch=1,EE,00355CD4,word,08039480

// 38. lookstep -- NPC HEADS turned twice as fast. It goes TOGETHER
//     with section 39, `brainphase`: they were measured combined.
//
//     The symptom: head turns run at double speed. The look update
//     moves pitch and then yaw with the angular interpolator 0x003373B8
//     ($f12 target, $f13 current): far from the target it advances
//     M = speed x 12 degrees, inside the radius D = 30 degrees it
//     advances M * error / D. PER UPDATE and without dt, so at 60 Hz
//     that is twice the steps per second. This section changes the
//     arguments:
//
//         M' = M / 2
//         D' = D / 2 * (1 + sqrt(max(0, 1 - M/D)))
//
//     The first keeps the maximum speed per second; the second makes
//     two damped steps shrink the error as much as one stock step:
//     (1 - M'/D')^2 = 1 - M/D. M/2 alone is not enough.
//
//     TWO hooks on the `jal`s to the interpolator (0x002488D4 pitch,
//     0x002488EC yaw), the `scenerebase` shape: a jump with `jal`, the
//     delay slot `mov.s $f14, $f21` -- which IS the step M -- is not
//     touched, and the routine ends with a `j` to the interpolator. The
//     EE's `sqrt.s` reads FT, not FS: 0x46010044.
//
//     Guards: live divider 1 and D > 0. At 30 fps it is inert. It does
//     not require dt == 1/60: in slow motion the interpolator still
//     limits per call, so without it heads would turn twice as fast
//     while the slow motion lasts; that branch is a `nop`. It preserves
//     the 128-bit $v0/$v1; it clobbers $at and $f0..$f2, just like the
//     interpolator. No mutable state. The routine, in its cave:
//
//       0x000E5600  27BDFFE0  addiu $sp, $sp, -32
//       0x000E5604  7FA20000  sq    $v0, 0($sp)
//       0x000E5608  7FA30010  sq    $v1, 16($sp)
//       0x000E560C  3C020059  lui   $v0, 0x0059
//       0x000E5610  34426D70  ori   $v0, $v0, 28016
//       0x000E5614  90420000  lbu   $v0, 0($v0)
//       0x000E5618  3C030000  lui   $v1, 0x0000
//       0x000E561C  34630001  ori   $v1, $v1, 1
//       0x000E5620  1443001D  bne   $v0, $v1, 0x000E5698
//       0x000E5624  00000000  nop
//       0x000E5628  3C020051  lui   $v0, 0x0051
//       0x000E562C  344202CC  ori   $v0, $v0, 716
//       0x000E5630  8C420000  lw    $v0, 0($v0)
//       0x000E5634  3C033C88  lui   $v1, 0x3C88
//       0x000E5638  34638889  ori   $v1, $v1, -30583
//       0x000E563C  00000000  nop
//       0x000E5640  00000000  nop
//       0x000E5644  44800000  mtc1  $zero, $f0
//       0x000E5648  46007836  c.le.s $f15, $f0
//       0x000E564C  45010012  bc1t   0x000E5698
//       0x000E5650  00000000  nop
//       0x000E5654  460F7043  div.s $f1, $f14, $f15
//       0x000E5658  3C013F80  lui   $at, 0x3F80
//       0x000E565C  34210000  ori   $at, $at, 0
//       0x000E5660  44811000  mtc1  $at, $f2
//       0x000E5664  46011041  sub.s $f1, $f2, $f1
//       0x000E5668  46000834  c.lt.s $f1, $f0
//       0x000E566C  45000002  bc1f   0x000E5678
//       0x000E5670  00000000  nop
//       0x000E5674  46000046  mov.s $f1, $f0
//       0x000E5678  46010044  sqrt.s $f1, $f1
//       0x000E567C  46020840  add.s $f1, $f1, $f2
//       0x000E5680  3C013F00  lui   $at, 0x3F00
//       0x000E5684  34210000  ori   $at, $at, 0
//       0x000E5688  44811000  mtc1  $at, $f2
//       0x000E568C  46027382  mul.s $f14, $f14, $f2
//       0x000E5690  46027BC2  mul.s $f15, $f15, $f2
//       0x000E5694  46017BC2  mul.s $f15, $f15, $f1
//       0x000E5698  7BA20000  lq    $v0, 0($sp)
//       0x000E569C  7BA30010  lq    $v1, 16($sp)
//       0x000E56A0  080CDCEE  j     0x003373B8
//       0x000E56A4  27BD0020  addiu $sp, $sp, 32
//
patch=1,EE,000E5600,word,27BDFFE0
patch=1,EE,000E5604,word,7FA20000
patch=1,EE,000E5608,word,7FA30010
patch=1,EE,000E560C,word,3C020059

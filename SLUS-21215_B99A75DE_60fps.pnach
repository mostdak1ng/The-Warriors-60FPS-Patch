patch=1,EE,000F184C,word,00000000
patch=1,EE,000F1850,word,00000000
patch=1,EE,000F1854,word,46092102
patch=1,EE,000F1858,word,46092942
patch=1,EE,000F185C,word,46093182
patch=1,EE,000F1860,word,46093AC2
patch=1,EE,000F1864,word,E7A40000
patch=1,EE,000F1868,word,E7A50004

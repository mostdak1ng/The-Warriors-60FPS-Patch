// 63. vibelines -- the VIBRATION LINES of the mug and the arrest, at
//     double speed (the normal mug, red lines, and resisting arrest,
//     blue lines): they cycled in 117 ms instead of 233.
//
//     The animation of the lines (0x001C0BB0, a HUD component shared by
//     the vibration modes) advances its counter once per call, without
//     dt. A hook on its entry, ONLY at normal 60 fps (divider 1,
//     dt 1/60): on the odd frame it returns without animating; the
//     drawing (another routine) still runs every frame. The minigame's
//     progress and decisions do not go through here. It preserves the
//     128-bit $t0-$t1; no state.
//
//       0x000F5A00  27BDFFE0  addiu $sp, $sp, -32
//       0x000F5A04  7FA80000  sq    $t0, 0($sp)
//       0x000F5A08  7FA90010  sq    $t1, 16($sp)
//       0x000F5A0C  3C080059  lui   $t0, 0x0059
//       0x000F5A10  35086D70  ori   $t0, $t0, 28016
//       0x000F5A14  91080000  lbu   $t0, 0($t0)
//       0x000F5A18  24090001  addiu $t1, $zero, 1
//       0x000F5A1C  15090013  bne   $t0, $t1, 0x000F5A6C
//       0x000F5A20  00000000  nop
//       0x000F5A24  3C080051  lui   $t0, 0x0051
//       0x000F5A28  350802CC  ori   $t0, $t0, 716
//       0x000F5A2C  8D080000  lw    $t0, 0($t0)

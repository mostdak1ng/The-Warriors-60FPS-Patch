patch=1,EE,002FA984,word,0803B300
patch=1,EE,002F9EBC,word,0803B380

// 55. gosound -- the GO card's beep, repeated too often. In All Over
//     The Neighbourhood the beep of the GO card (vags/misc/bleep27)
//     repeated every 13 fields (~217 ms) instead of 16 (~267). Same
//     pitch and volume: a faster repetition.
//
//     The card's consumer (0x0019ED28) does not ask for the beep again
//     while it resolves the handle of the previous one (HUD+0x3D8,
//     0x0010F578), and the audio engine retires that instance after a
//     number of updates: at 60 it is retired sooner.
//
//     This section, with dt 1/60 and live divider 1, in two hooks:
//     `wait` (0x0019EDAC, the branch 'the instance is alive: do not
//     ask') arms a two-update wait while the instance is alive, counts
//     it down when it disappears and then asks on an even phase with
//     respect to the previous request; `anchor` (0x0019EDF0, where the
//     new handle is stored) records that handle and the frame
//     (0x0050C654) of the request. A jump in frames, a handle without
//     an anchor or the first beep take the native path; outside 60,
//     everything native. Both slots run LIVE and are not written. It
//     does not touch the global audio service. No dependencies. Each
//     routine preserves the 128-bit $t0-$t2.
//
//     The STATE (handle, wait, last frame, request frame) is zeroed
//     ONCE at boot and NEVER with patch=1: doing it every frame would
//     erase the wait and this section would do nothing. Zero means 'no
//     anchor', which is also how a save state made without the patch
//     starts.
patch=0,EE,000EF300,word,00000000
patch=0,EE,000EF304,word,00000000
patch=0,EE,000EF308,word,00000000
patch=0,EE,000EF30C,word,00000000
//
//     The routines, in their caves:
//
//       0x000EF000  27BDFFD0  addiu $sp, $sp, -48
//       0x000EF004  7FA80000  sq    $t0, 0($sp)
//       0x000EF008  7FA90010  sq    $t1, 16($sp)
//       0x000EF00C  7FAA0020  sq    $t2, 32($sp)
//       0x000EF010  3C080059  lui   $t0, 0x0059
//       0x000EF014  35086D70  ori   $t0, $t0, 28016
//       0x000EF018  91090000  lbu   $t1, 0($t0)
//       0x000EF01C  240A0001  addiu $t2, $zero, 1
//       0x000EF020  152A002D  bne   $t1, $t2, 0x000EF0D8
//       0x000EF024  00000000  nop
//       0x000EF028  3C080051  lui   $t0, 0x0051
//       0x000EF02C  350802CC  ori   $t0, $t0, 716
//       0x000EF030  8D090000  lw    $t1, 0($t0)
//       0x000EF034  3C0A3C88  lui   $t2, 0x3C88
//       0x000EF038  354A8889  ori   $t2, $t2, -30583
//       0x000EF03C  152A0026  bne   $t1, $t2, 0x000EF0D8
//       0x000EF040  00000000  nop
//       0x000EF044  3C08000E  lui   $t0, 0x000E
//       0x000EF048  3508F300  ori   $t0, $t0, -3328
//       0x000EF04C  3C0A0050  lui   $t2, 0x0050
//       0x000EF050  354AC654  ori   $t2, $t2, -14764
//       0x000EF054  8D4A0000  lw    $t2, 0($t2)
//       0x000EF058  14400012  bne   $v0, $zero, 0x000EF0A4
//       0x000EF05C  00000000  nop
//       0x000EF060  8D090008  lw    $t1, 8($t0)
//       0x000EF064  01494823  subu  $t1, $t2, $t1
//       0x000EF068  AD0A0008  sw    $t2, 8($t0)
//       0x000EF06C  240A0001  addiu $t2, $zero, 1
//       0x000EF070  152A001F  bne   $t1, $t2, 0x000EF0F0
//       0x000EF074  00000000  nop
//       0x000EF078  8E6903D8  lw    $t1, 984($s3)
//       0x000EF07C  8D0A0000  lw    $t2, 0($t0)
//       0x000EF080  152A001B  bne   $t1, $t2, 0x000EF0F0
//       0x000EF084  00000000  nop
//       0x000EF088  8D090004  lw    $t1, 4($t0)
//       0x000EF08C  1120000A  beq   $t1, $zero, 0x000EF0B8
//       0x000EF090  00000000  nop
//       0x000EF094  2529FFFF  addiu $t1, $t1, -1
//       0x000EF098  AD090004  sw    $t1, 4($t0)
//       0x000EF09C  1000001A  beq   $zero, $zero, 0x000EF108
//       0x000EF0A0  00000000  nop
//       0x000EF0A4  AD0A0008  sw    $t2, 8($t0)
//       0x000EF0A8  24090002  addiu $t1, $zero, 2
//       0x000EF0AC  AD090004  sw    $t1, 4($t0)
//       0x000EF0B0  10000015  beq   $zero, $zero, 0x000EF108
//       0x000EF0B4  00000000  nop
//       0x000EF0B8  8D090008  lw    $t1, 8($t0)
//       0x000EF0BC  8D0A000C  lw    $t2, 12($t0)
//       0x000EF0C0  012A4823  subu  $t1, $t1, $t2
//       0x000EF0C4  31290001  andi  $t1, $t1, 1
//       0x000EF0C8  1520000F  bne   $t1, $zero, 0x000EF108
//       0x000EF0CC  00000000  nop
//       0x000EF0D0  10000007  beq   $zero, $zero, 0x000EF0F0
//       0x000EF0D4  00000000  nop
//       0x000EF0D8  3C08000E  lui   $t0, 0x000E
//       0x000EF0DC  3508F300  ori   $t0, $t0, -3328
//       0x000EF0E0  AD000004  sw    $zero, 4($t0)
//       0x000EF0E4  AD000008  sw    $zero, 8($t0)
//       0x000EF0E8  14400007  bne   $v0, $zero, 0x000EF108
//       0x000EF0EC  00000000  nop
//       0x000EF0F0  7BA80000  lq    $t0, 0($sp)
//       0x000EF0F4  7BA90010  lq    $t1, 16($sp)
//       0x000EF0F8  7BAA0020  lq    $t2, 32($sp)
//       0x000EF0FC  27BD0030  addiu $sp, $sp, 48
//       0x000EF100  08067B6D  j     0x0019EDB4
//       0x000EF104  00000000  nop
//       0x000EF108  7BA80000  lq    $t0, 0($sp)
//       0x000EF10C  7BA90010  lq    $t1, 16($sp)
//       0x000EF110  7BAA0020  lq    $t2, 32($sp)
//       0x000EF114  27BD0030  addiu $sp, $sp, 48
//       0x000EF118  08067B73  j     0x0019EDCC
//       0x000EF11C  00000000  nop
//       0x000EF180  AE6203D8  sw    $v0, 984($s3)
//       0x000EF184  27BDFFE0  addiu $sp, $sp, -32
//       0x000EF188  7FA80000  sq    $t0, 0($sp)
//       0x000EF18C  7FA90010  sq    $t1, 16($sp)
//       0x000EF190  3C08000E  lui   $t0, 0x000E
//       0x000EF194  3508F300  ori   $t0, $t0, -3328
//       0x000EF198  AD020000  sw    $v0, 0($t0)
//       0x000EF19C  3C090050  lui   $t1, 0x0050
//       0x000EF1A0  3529C654  ori   $t1, $t1, -14764
//       0x000EF1A4  8D290000  lw    $t1, 0($t1)
//       0x000EF1A8  AD09000C  sw    $t1, 12($t0)
//       0x000EF1AC  7BA80000  lq    $t0, 0($sp)
//       0x000EF1B0  7BA90010  lq    $t1, 16($sp)
//       0x000EF1B4  27BD0020  addiu $sp, $sp, 32
//       0x000EF1B8  08067B7E  j     0x0019EDF8
//       0x000EF1BC  00000000  nop
//

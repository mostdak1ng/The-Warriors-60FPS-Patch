//
//     and only now the two hooks. They go WITHOUT their delay slot,
//     the opposite of every section above: the slot is part of the call
//     being replaced and the routine does not replay it, so NOPing it
//     would eat a live instruction.
patch=1,EE,00104CCC,word,0C039000
patch=1,EE,00104BB4,word,0C039200

// 36. cutpose -- the POSE jumps ahead of the camera CUT.
//
//     The symptom: on the last frame before a cut, Spider disappears and
//     Ajax and Snow shift. `cutshift` already recognises the cut and
//     holds the physical root on the previous half frame, but the pose
//     is still evaluated halfway through the key that crosses it, i.e.
//     with the pose of the NEXT shot. During THAT half frame this
//     section evaluates the pose at the last 30 Hz key, which is what
//     stock shows there:
//
//         $f21 = float(cursor)    if 0.25 <= $f21 - cursor < 0.75
//
//     $f21 is read by pose channel 1 and by the loop over the 33 bones;
//     the root rotation is not. It does not touch the clock, cursors,
//     events, camera or the velocity channel, and the function restores
//     $f21 on exit.
//
//     Guards: the SceneAnim ancestor 0x00106B7C read from the original
//     stack +0x40, dt == 1/60 with live divider 1, $f20 == 1, and
//     `cutshift`'s marker on the half frame BEFORE the cut
//     ([MARK] == [WORLD_SUBSTEP] + 1). It DEPENDS on `cutshift`: it only
//     acts where that detector sees a cut. At 30 fps it is inert.
//
//     It preserves the 128-bit $t0/$t1/$t2, $f13 and FCR31. No mutable
//     state. The routine, in its cave:
//
//       0x000E5000  27BDFFC0  addiu $sp, $sp, -64
//       0x000E5004  7FA80000  sq    $t0, 0($sp)
//       0x000E5008  7FA90010  sq    $t1, 16($sp)
//       0x000E500C  7FAA0020  sq    $t2, 32($sp)
//       0x000E5010  E7AD0030  swc1  $f13, 48($sp)
//       0x000E5014  444AF800  cfc1  $t2, $f31
//       0x000E5018  AFAA0034  sw    $t2, 52($sp)
//       0x000E501C  8FA80080  lw    $t0, 128($sp)
//       0x000E5020  3C090010  lui   $t1, 0x0010
//       0x000E5024  35296B7C  ori   $t1, $t1, 27516
//       0x000E5028  15090033  bne   $t0, $t1, 0x000E50F8
//       0x000E502C  00000000  nop
//       0x000E5030  3C080051  lui   $t0, 0x0051
//       0x000E5034  350802CC  ori   $t0, $t0, 716
//       0x000E5038  8D080000  lw    $t0, 0($t0)
//       0x000E503C  3C093C88  lui   $t1, 0x3C88
//       0x000E5040  35298889  ori   $t1, $t1, -30583
//       0x000E5044  1509002C  bne   $t0, $t1, 0x000E50F8
//       0x000E5048  00000000  nop
//       0x000E504C  3C080059  lui   $t0, 0x0059
//       0x000E5050  35086D70  ori   $t0, $t0, 28016
//       0x000E5054  91080000  lbu   $t0, 0($t0)
//       0x000E5058  3C090000  lui   $t1, 0x0000
//       0x000E505C  35290001  ori   $t1, $t1, 1
//       0x000E5060  15090025  bne   $t0, $t1, 0x000E50F8
//       0x000E5064  00000000  nop
//       0x000E5068  4408A000  mfc1  $t0, $f20

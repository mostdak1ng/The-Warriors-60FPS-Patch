patch=1,EE,002488D4,word,0C039580
patch=1,EE,002488EC,word,0C039580

// 39. brainphase -- the AI thought on TWO turns in a row. It goes
//     together with section 38, and it applies to EVERY brain.
//
//     The symptom: `brainrate` (section 14) restored the AVERAGE of 6
//     thinks per second per brain, but with (tick >> 1) % 10 each group
//     gets two turns ~17 ms apart and then waits ~317; stock thinks
//     every ~167 ms, evenly. Attention -- where the head looks -- is
//     chosen on that pass, and it was chosen out of time.
//
//     This section hooks the branch `bne $v0, $s3, 0x00293BE4` of the
//     round-robin. At 60 fps it lets the HEAVY pass (0x0028F6C0) run
//     only on EVEN ticks and with the groups equal modulo 5; the light
//     one (0x0028F8B8) keeps running always. That is exactly stock's
//     schedule: its world update skips the odd ticks (0x00249148) and
//     hands the tick to the round-robin (0x00249214).
//
//     Guards: dt == 1/60 with live divider 1; otherwise, the original
//     condition. It DEPENDS on `brainrate`. It preserves the 128-bit
//     $t0..$t2 and reads $v0/$s3 without writing them. No mutable
//     state. The routine, in its cave:
//
//       0x000E6000  27BDFFD0  addiu $sp, $sp, -48
//       0x000E6004  7FA80000  sq    $t0, 0($sp)
//       0x000E6008  7FA90010  sq    $t1, 16($sp)
//       0x000E600C  7FAA0020  sq    $t2, 32($sp)
//       0x000E6010  3C080059  lui   $t0, 0x0059
//       0x000E6014  35086D70  ori   $t0, $t0, 28016
//       0x000E6018  91080000  lbu   $t0, 0($t0)
//       0x000E601C  3C090000  lui   $t1, 0x0000
//       0x000E6020  35290001  ori   $t1, $t1, 1
//       0x000E6024  15090018  bne   $t0, $t1, 0x000E6088
//       0x000E6028  00000000  nop
//       0x000E602C  3C080051  lui   $t0, 0x0051
//       0x000E6030  350802CC  ori   $t0, $t0, 716
//       0x000E6034  8D080000  lw    $t0, 0($t0)
//       0x000E6038  3C093C88  lui   $t1, 0x3C88
//       0x000E603C  35298889  ori   $t1, $t1, -30583
//       0x000E6040  15090011  bne   $t0, $t1, 0x000E6088
//       0x000E6044  00000000  nop
//       0x000E6048  3C080051  lui   $t0, 0x0051
//       0x000E604C  350804F4  ori   $t0, $t0, 1268
//       0x000E6050  8D080000  lw    $t0, 0($t0)
//       0x000E6054  31080001  andi  $t0, $t0, 1
//       0x000E6058  1500000D  bne   $t0, $zero, 0x000E6090
//       0x000E605C  00000000  nop
//       0x000E6060  10530010  beq   $v0, $s3, 0x000E60A4
//       0x000E6064  00000000  nop
//       0x000E6068  24480005  addiu $t0, $v0, 5
//       0x000E606C  1113000D  beq   $t0, $s3, 0x000E60A4
//       0x000E6070  00000000  nop
//       0x000E6074  26680005  addiu $t0, $s3, 5
//       0x000E6078  1048000A  beq   $v0, $t0, 0x000E60A4
//       0x000E607C  00000000  nop
//       0x000E6080  10000003  beq   $zero, $zero, 0x000E6090
//       0x000E6084  00000000  nop
//       0x000E6088  10530006  beq   $v0, $s3, 0x000E60A4
//       0x000E608C  00000000  nop
//       0x000E6090  7BA80000  lq    $t0, 0($sp)
//       0x000E6094  7BA90010  lq    $t1, 16($sp)
//       0x000E6098  7BAA0020  lq    $t2, 32($sp)
//       0x000E609C  080A4EF9  j     0x00293BE4
//       0x000E60A0  27BD0030  addiu $sp, $sp, 48
//       0x000E60A4  7BA80000  lq    $t0, 0($sp)
//       0x000E60A8  7BA90010  lq    $t1, 16($sp)
//       0x000E60AC  7BAA0020  lq    $t2, 32($sp)
//       0x000E60B0  080A4EF7  j     0x00293BDC
//       0x000E60B4  27BD0030  addiu $sp, $sp, 48
//
patch=1,EE,000E6000,word,27BDFFD0
patch=1,EE,000E6004,word,7FA80000
patch=1,EE,000E6008,word,7FA90010
patch=1,EE,000E600C,word,7FAA0020

//       0x000F5118  24090001  addiu $t1, $zero, 1
//       0x000F511C  15090012  bne   $t0, $t1, 0x000F5168
//       0x000F5120  00000000  nop
//       0x000F5124  3C093C88  lui   $t1, 0x3C88
//       0x000F5128  35298889  ori   $t1, $t1, -30583
//       0x000F512C  8EA801A0  lw    $t0, 416($s5)

gametitle=The Warriors (USA) [SLUS-21215] (v1.03) [CRC B99A75DE]
comment=The Warriors 60FPS Patch v1.0.0 by Claude + mostdak1ng - MIT

[The Warriors 60FPS Patch]
author=mostdak1ng
description=Runs the game at 60 fps: 60 distinct simulation states per second, at the correct world speed. Hold Select+L2+R2 for one second to switch input lag between STOCK (the original game's response, the default) and OFF (fastest). Unticking this patch while the game runs returns it to the original 30 fps. Applied on startup and every frame; PCSX2 shows this as 'Unknown' because the patch uses both.

// 1. Display divider. 0x0050CDB0 lives in .data, is read exactly once at
//    boot (0x00194AEC) and handed to SetFlipQueueLimit, which copies it to
//    0x00596D70. fps = 59.94 / N, measured exact at N = 1,2,3,4.
//    Patched once at boot so it is in place before the init reads it, and
//    every frame as well in case the read happens first.
patch=0,EE,0050CDB0,byte,00000001
patch=1,EE,0050CDB0,byte,00000001
patch=1,EE,00596D70,byte,00000001

// 2. The frame-parity gate. The world update at 0x0024910C runs every
//    frame but skips its whole body on odd frames:
//        andi $a0, $v1, 1   ; parity
//        bnez $a0, 0x249b60 ; odd -> jump to the end of the function
//    Masking with 0 instead of 1 makes the branch never taken, so the
//    simulation advances every frame. Without this the divider alone
//    only produces duplicate frames.
patch=1,EE,0024912C,word,30640000

// 3. Simulation timestep, 1/30 -> 1/60.
//
//    The live value at 0x005102CC is seeded ONCE at boot. This is not
//    optional: the constants below are only executed when the engine
//    changes timestep state, and a running game leaves 0x005102CC
//    untouched for many seconds at a time. Patching only the constants
//    would leave the live value at 1/30 while the display and the parity
//    gate already ran at 60, i.e. the world at DOUBLE speed until the
//    first level transition.
patch=0,EE,005102CC,word,3C888889
//
//    The constants are patched too so every later write also produces
//    1/60. Doing it at the sources rather than holding 0x005102CC every
//    frame keeps SetSlowMo working: its scale multiplies the base, so a
//    0.5 scale still means half speed.
patch=1,EE,0023B7C8,word,3C013C88
patch=1,EE,0023B7FC,word,3C013C88
patch=1,EE,0030C94C,word,3C013C88
patch=1,EE,0030C9A8,word,3C013C88
patch=1,EE,0041AB40,word,3C013C88
patch=1,EE,0041ABA4,word,3C013C88

// 4. The 30 fps cap: a fixed-timestep accumulator at 0x003A2EA0, called
//    once per presented frame. It waits for TWO units of 0x004B0000 to
//    pile up and then runs the world update twice, back to back:
//        sltiu $v0, $s2, 2     ; substeps per pass
//        sltu  $v0, $s7, $s1   ; while more than two units remain
//    Halving the quantum and the substep count makes it run ONCE per
//    unit, so the world advances exactly once per presented frame.
//    Without this, 1-3 give 60 frames carrying 30 distinct states and
//    every second frame is an exact duplicate (measured: 50.1% novel).
//    With it: 100.0% novel, world speed within 1% of stock.
patch=1,EE,003A2F08,word,3C02004A
patch=1,EE,003A2F30,word,3C17004A
patch=1,EE,003A2F94,word,2E420001

// 5. The camera's timestep floor. The world update ends by handing the
//    camera manager a dt, and it builds that dt like this:
//        lui   $at, 0x3D08
//        ori   $at, $at, 0x8889   ; 1/30, inline
//        mtc1  $at, $f12
//        lwc1  $f0, 0x2CC($v0)    ; the live global timestep
//        max.s $f12, $f0, $f12    ; dt = max(global, 1/30)
//        jal   0x0011E878         ; CameraManager::Update(dt)
//    so the camera is never told a step shorter than 1/30 of a second.
//    Stock that is exactly right. With everything above applied the
//    global says 1/60, the floor wins, and the camera runs 60 times a
//    second believing each step lasts 1/30 -- twice the rotation.
//    Every camera class stores that argument at this+0x1A0, which is
//    why a stubborn 1/30 shows up there.
//    Measured: 149 deg/s stock, 299 with 1-4, 151 with this line.
//    Same constant and same lui as section 3; it is easy to miss
//    because this site only reads the global and never writes it.
patch=1,EE,00249B44,word,3C013C88

// 6. The clock object's own copy of the timestep. The engine keeps a
//    second copy at [0x0050B734] + 0x4C and the accumulator of section
//    4 is fed from it, so leaving it at 1/30 while the quantum is
//    already halved hands the accumulator TWO units every frame and
//    runs the world update TWICE per presented frame.
//
//    That is what makes the main menu unusable: the ring of button
//    samples at 0x005DD810+0x1C is turned by the world update, so it
//    advances two slots per frame while the front end reads one, and a
//    slot nobody reads is a lost edge. just_pressed (0x00144BF0)
//    compares adjacent slots, so Start never registers -- while the
//    left stick keeps working, because an axis is a value and survives
//    a skipped slot. Measured on press-start: 2.013 ring advances per
//    frame against 1.007 reads, and 1.000 against 1.000 with this line.
//
//    The copy itself lives on the heap, so a .pnach cannot name it.
//    The CONSTRUCTOR it can: 0x001459C8 seeds it with the same
//    lui 0x3D08 as section 3, right before storing 1.0 into the
//    scale at +0x50. Verified live: the copy survives a screen
//    transition that used to reset it to 1/30.
patch=1,EE,001459C8,word,3C013C88

// A clock object ALREADY built when the patch is switched on keeps its
// old copy, because the constructor only runs once per object. That
// happens when the patch is enabled in a running game or a save state
// made without it is loaded; clockheal (section 53) repairs the live
// copy in those cases. From boot, section 6 covers it.

// 7. rootturn -- cutscene actors turning twice as far.
//
//    0x0023F238 turns a scripted actor with quat = quat * delta, and
//    it builds that delta two different ways:
//
//        0x0023F46C  mul.s $f0, $f0, $f2  ; dt * 30.0 -- the engine's
//                                         ;  own per-1/30-s convention
//        0x0023F4FC  sq $v0, 0($sp)       ; the ANIMATION's root
//                                         ;  rotation, raw, no dt
//
//    obj+0x280 decides which, and cutscene actors always take the raw
//    one. Measured on one cutscene over the same 6 s of game clock: 181
//    ticks stock against 361 patched, and the SAME delta per tick
//    (max 4.8450 degrees in both). Twice the ticks times the same
//    step is an exact factor of two.
//
//    The root TRANSLATION of that same transform is fine, and that is
//    the proof this is the whole bug: 0x0023F374 adds it to the
//    velocity, which is integrated with dt later -- which is why
//    position drifts much later than heading.
//
//    So the fix gives the raw path the engine's own dt*30 convention.
//    At 60 fps that factor is exactly 1/2, and half of a rotation
//    quaternion is its square root, (x, y, z, 1+w) / sqrt(2+2w). The
//    routine lives in free RAM below the ELF and the store site jumps
//    to it. It touches no GPR but $at: $v0 is live across the site,
//    loaded in the delay slot at 0x0023F500 and stored at 0x0023F50C.
//
//    Verified against stock on the same cutscene at the same game
//    clock: the heading error went from 75 deg median / 144 deg max
//    down to 0.00 median / 2.27 max.
//
//    The routine sits at 0x000F1800, clear of the Freecam mod
//    (0x000F0000..0x000F13AC), so both can be enabled at once.
//
//    Written every frame, not once at boot: the routine has to be in
//    place before the hook can be taken, and a save state load would
//    otherwise wipe it and leave the jump pointing at zeros.
//
//    The routine, disassembled (the patch lines below are the same
//    words; a comment on a patch line is not worth the risk of a
//    parser dropping it):
//
//      0x000F1800  C6040010  lwc1   $f4, 0x10($s0)      x
//      0x000F1804  C6050014  lwc1   $f5, 0x14($s0)      y
//      0x000F1808  C6060018  lwc1   $f6, 0x18($s0)      z
//      0x000F180C  C60B001C  lwc1   $f11, 0x1C($s0)     w
//      0x000F1810  3C013F80  lui    $at, 0x3F80
//      0x000F1814  44814000  mtc1   $at, $f8            1.0
//      0x000F1818  3C013F00  lui    $at, 0x3F00
//      0x000F181C  44815000  mtc1   $at, $f10           0.5
//      0x000F1820  00000000  nop
//      0x000F1824  460859C0  add.s  $f7, $f11, $f8      s = w + 1
//      0x000F1828  00000000  nop
//      0x000F182C  460A3834  c.lt.s $f7, $f10           more than 120 deg in one tick?
//      0x000F1830  00000000  nop
//      0x000F1834  4501000B  bc1t   +11                 then pass it through untouched
//      0x000F1838  46073A40  add.s  $f9, $f7, $f7       delay slot: 2s = |q + 1|^2
//      0x000F183C  46090244  sqrt.s $f9, $f9
//      0x000F1840  00000000  nop
//      0x000F1844  00000000  nop
//      0x000F1848  46094243  div.s  $f9, $f8, $f9       1 / sqrt(2s)
//      0x000F184C  00000000  nop
//      0x000F1850  00000000  nop
//      0x000F1854  46092102  mul.s  $f4, $f4, $f9
//      0x000F1858  46092942  mul.s  $f5, $f5, $f9
//      0x000F185C  46093182  mul.s  $f6, $f6, $f9
//      0x000F1860  46093AC2  mul.s  $f11, $f7, $f9
//      0x000F1864  E7A40000  swc1   $f4, 0($sp)
//      0x000F1868  E7A50004  swc1   $f5, 4($sp)
//      0x000F186C  E7A60008  swc1   $f6, 8($sp)
//      0x000F1870  E7AB000C  swc1   $f11, 12($sp)
//      0x000F1874  0808FD41  j 0x0023F504
//      0x000F1878  00000000  nop
//
patch=1,EE,000F1800,word,C6040010
patch=1,EE,000F1804,word,C6050014
patch=1,EE,000F1808,word,C6060018
patch=1,EE,000F180C,word,C60B001C
patch=1,EE,000F1810,word,3C013F80
patch=1,EE,000F1814,word,44814000
patch=1,EE,000F1818,word,3C013F00
patch=1,EE,000F181C,word,44815000
patch=1,EE,000F1820,word,00000000
patch=1,EE,000F1824,word,460859C0
patch=1,EE,000F1828,word,00000000
patch=1,EE,000F182C,word,460A3834
patch=1,EE,000F1830,word,00000000

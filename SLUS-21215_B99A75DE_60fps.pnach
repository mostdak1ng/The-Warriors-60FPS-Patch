//       0x000E426C  44811000  mtc1  $at, $f2
//       0x000E4270  46011082  mul.s $f2, $f2, $f1
//       0x000E4274  3C013638  lui   $at, 0x3638
//       0x000E4278  3421EF1D  ori   $at, $at, -4323
//       0x000E427C  44812000  mtc1  $at, $f4
//       0x000E4280  46041080  add.s $f2, $f2, $f4

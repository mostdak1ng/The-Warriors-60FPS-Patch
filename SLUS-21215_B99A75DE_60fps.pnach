// 41. cutrot -- the object's ROTATION does not jump ahead of the cut.
//     The door in Payin' the Cost. The rotation half of section 29
//     (`cutprop`).
//
//     The symptom: on the last frame before the camera jump, the door
//     leaf covering Swan and Cleon disappeared. It is not hidden: it
//     TURNS. Its rotation key jumps ~62 degrees at the cut, and the
//     game only asks the CAMERA not to interpolate a jump like that
//     (0x0039CF5C with $a1 = 1); objects and lights go with 0. At
//     60 fps the half step before it showed the leaf halfway there.
//
//     This section displaces the SAME pair as section 29 (`lwc1 $f0` /
//     `sub.s $f1`), in the ROTATION interpolation of 0x00355AB8: with
//     the same guards it puts in the previous key's time and the factor
//     comes out zero. Guards: the objects or lights chain (not the
//     camera), dt == 1/60, the half frame before the cut according to
//     section 28's marker, adjacent keys and a gap in [1/120, 1/40). It
//     DEPENDS on `cutshift`. It preserves the 128-bit $t0..$t3 and
//     $f13. No mutable state. The routine, in its cave:
//
//       0x000E7000  27BDFFB0  addiu $sp, $sp, -80
//       0x000E7004  7FA80000  sq    $t0, 0($sp)
//       0x000E7008  7FA90010  sq    $t1, 16($sp)
//       0x000E700C  7FAA0020  sq    $t2, 32($sp)
//       0x000E7010  7FAB0030  sq    $t3, 48($sp)
//       0x000E7014  E7AD0040  swc1  $f13, 64($sp)
//       0x000E7018  C4E00010  lwc1  $f0, 16($a3)
//       0x000E701C  8FA800A0  lw    $t0, 160($sp)
//       0x000E7020  3C090035  lui   $t1, 0x0035
//       0x000E7024  35296130  ori   $t1, $t1, 24880
//       0x000E7028  15090032  bne   $t0, $t1, 0x000E70F4
//       0x000E702C  00000000  nop
//       0x000E7030  8FA800B0  lw    $t0, 176($sp)
//       0x000E7034  3C090039  lui   $t1, 0x0039
//       0x000E7038  3529D06C  ori   $t1, $t1, -12180
//       0x000E703C  11090005  beq   $t0, $t1, 0x000E7054
//       0x000E7040  00000000  nop
//       0x000E7044  3C090039  lui   $t1, 0x0039
//       0x000E7048  3529D158  ori   $t1, $t1, -11944
//       0x000E704C  15090029  bne   $t0, $t1, 0x000E70F4
//       0x000E7050  00000000  nop
//       0x000E7054  3C080051  lui   $t0, 0x0051
//       0x000E7058  350802CC  ori   $t0, $t0, 716
//       0x000E705C  8D080000  lw    $t0, 0($t0)
//       0x000E7060  3C093C88  lui   $t1, 0x3C88
//       0x000E7064  35298889  ori   $t1, $t1, -30583
//       0x000E7068  15090022  bne   $t0, $t1, 0x000E70F4
//       0x000E706C  00000000  nop
//       0x000E7070  3C08000E  lui   $t0, 0x000E
//       0x000E7074  350823F0  ori   $t0, $t0, 9200
//       0x000E7078  8D080000  lw    $t0, 0($t0)
//       0x000E707C  1100001D  beq   $t0, $zero, 0x000E70F4
//       0x000E7080  00000000  nop
//       0x000E7084  3C090051  lui   $t1, 0x0051
//       0x000E7088  352904F4  ori   $t1, $t1, 1268
//       0x000E708C  8D290000  lw    $t1, 0($t1)
//       0x000E7090  25290001  addiu $t1, $t1, 1
//       0x000E7094  15090017  bne   $t0, $t1, 0x000E70F4
//       0x000E7098  00000000  nop
//       0x000E709C  8CE8001C  lw    $t0, 28($a3)
//       0x000E70A0  95080000  lhu   $t0, 0($t0)
//       0x000E70A4  8CE90020  lw    $t1, 32($a3)
//       0x000E70A8  95290000  lhu   $t1, 0($t1)
//       0x000E70AC  01284023  subu  $t0, $t1, $t0
//       0x000E70B0  3C090000  lui   $t1, 0x0000
//       0x000E70B4  35290001  ori   $t1, $t1, 1
//       0x000E70B8  1509000E  bne   $t0, $t1, 0x000E70F4
//       0x000E70BC  00000000  nop
//       0x000E70C0  46002341  sub.s $f13, $f4, $f0
//       0x000E70C4  44086800  mfc1  $t0, $f13
//       0x000E70C8  3C093C08  lui   $t1, 0x3C08
//       0x000E70CC  35298889  ori   $t1, $t1, -30583
//       0x000E70D0  0109502B  sltu  $t2, $t0, $t1
//       0x000E70D4  15400007  bne   $t2, $zero, 0x000E70F4
//       0x000E70D8  00000000  nop
//       0x000E70DC  3C093CCC  lui   $t1, 0x3CCC
//       0x000E70E0  3529CCCD  ori   $t1, $t1, -13107

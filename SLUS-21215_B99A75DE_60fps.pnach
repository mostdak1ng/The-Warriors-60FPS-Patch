// 67. spraychord -- the SPRAY ATTACK came out with Circle held too
//     long: with Circle and Triangle 217 ms later, the attack always
//     came out; in stock, half the time (otherwise it is a crouch, the
//     action for holding Circle).
//
//     Section 22 (chord30) decides the chord on the 30 Hz grid and
//     delays it, and the hold-Circle action (section 8) arrives late. A
//     hook on the branch after the chord classifier, where section 47
//     (sprintchord) returns: ONLY at normal 60 fps, with sections 8 and
//     22, for action 36 (Circle + Triangle), if section 8's Circle
//     counter has already passed 2N samples, the chord does not win. It
//     does not write the counter; no state. It depends on sections 8
//     and 22. The routine, in its cave:
//
//       0x000F5D00  27BDFFC0  addiu $sp, $sp, -64
//       0x000F5D04  7FA80000  sq    $t0, 0($sp)
//       0x000F5D08  7FA90010  sq    $t1, 16($sp)
//       0x000F5D0C  7FAA0020  sq    $t2, 32($sp)
//       0x000F5D10  7FAB0030  sq    $t3, 48($sp)
//       0x000F5D14  10400036  beq   $v0, $zero, 0x000F5DF0
//       0x000F5D18  00000000  nop
//       0x000F5D1C  8E080004  lw    $t0, 4($s0)
//       0x000F5D20  24090024  addiu $t1, $zero, 36
//       0x000F5D24  15090032  bne   $t0, $t1, 0x000F5DF0
//       0x000F5D28  00000000  nop
//       0x000F5D2C  3C080051  lui   $t0, 0x0051
//       0x000F5D30  350802CC  ori   $t0, $t0, 716
//       0x000F5D34  8D080000  lw    $t0, 0($t0)
//       0x000F5D38  3C093C88  lui   $t1, 0x3C88
//       0x000F5D3C  35298889  ori   $t1, $t1, -30583
//       0x000F5D40  1509002B  bne   $t0, $t1, 0x000F5DF0
//       0x000F5D44  00000000  nop
//       0x000F5D48  3C080059  lui   $t0, 0x0059
//       0x000F5D4C  35086D70  ori   $t0, $t0, 28016
//       0x000F5D50  91080000  lbu   $t0, 0($t0)
//       0x000F5D54  24090001  addiu $t1, $zero, 1
//       0x000F5D58  15090025  bne   $t0, $t1, 0x000F5DF0
//       0x000F5D5C  00000000  nop
//       0x000F5D60  3C080014  lui   $t0, 0x0014
//       0x000F5D64  35084F54  ori   $t0, $t0, 20308
//       0x000F5D68  8D080000  lw    $t0, 0($t0)
//       0x000F5D6C  3C093084  lui   $t1, 0x3084
//       0x000F5D70  35290006  ori   $t1, $t1, 6
//       0x000F5D74  1509001E  bne   $t0, $t1, 0x000F5DF0
//       0x000F5D78  00000000  nop
//       0x000F5D7C  3C080014  lui   $t0, 0x0014
//       0x000F5D80  35084E50  ori   $t0, $t0, 20048
//       0x000F5D84  8D080000  lw    $t0, 0($t0)
//       0x000F5D88  3C098C82  lui   $t1, 0x8C82
//       0x000F5D8C  3529002C  ori   $t1, $t1, 44
//       0x000F5D90  15090017  bne   $t0, $t1, 0x000F5DF0
//       0x000F5D94  00000000  nop
//       0x000F5D98  3C080050  lui   $t0, 0x0050
//       0x000F5D9C  3508B708  ori   $t0, $t0, -18680
//       0x000F5DA0  8D080000  lw    $t0, 0($t0)
//       0x000F5DA4  2D090008  sltiu $t1, $t0, 8
//       0x000F5DA8  11200011  beq   $t1, $zero, 0x000F5DF0
//       0x000F5DAC  00000000  nop
//       0x000F5DB0  1100000F  beq   $t0, $zero, 0x000F5DF0
//       0x000F5DB4  00000000  nop
//       0x000F5DB8  3C09000F  lui   $t1, 0x000F
//       0x000F5DBC  35291914  ori   $t1, $t1, 6420
//       0x000F5DC0  8D290000  lw    $t1, 0($t1)
//       0x000F5DC4  8E6A002C  lw    $t2, 44($s3)
//       0x000F5DC8  314A0001  andi  $t2, $t2, 1
//       0x000F5DCC  012A582B  sltu  $t3, $t1, $t2
//       0x000F5DD0  15600007  bne   $t3, $zero, 0x000F5DF0
//       0x000F5DD4  00000000  nop
//       0x000F5DD8  012A4823  subu  $t1, $t1, $t2
//       0x000F5DDC  00084040  sll   $t0, $t0, 1
//       0x000F5DE0  0109402B  sltu  $t0, $t0, $t1
//       0x000F5DE4  11000002  beq   $t0, $zero, 0x000F5DF0
//       0x000F5DE8  00000000  nop
//       0x000F5DEC  0000102D  daddu $v0, $zero, $zero
//       0x000F5DF0  7BA80000  lq    $t0, 0($sp)
//       0x000F5DF4  7BA90010  lq    $t1, 16($sp)
//       0x000F5DF8  7BAA0020  lq    $t2, 32($sp)
//       0x000F5DFC  7BAB0030  lq    $t3, 48($sp)

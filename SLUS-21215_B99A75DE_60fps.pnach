//
//     and only now the hook, with its delay slot NOPed BEFORE the
//     jump: what it displaces is the `lui $at, 0x3A80` the routine
//     REPLAYS, so leaving it there would run it twice.
patch=1,EE,00104BCC,word,00000000
patch=1,EE,00104BC8,word,08038F80

// 35. scenerebase -- Scopes JUMPS while falling and when landing.
//
//     The symptom: during the fall Scopes goes up for one frame and
//     comes back on the next, five times, and a sixth time already on
//     the floor. The cause is not a cursor or an integrated quantity:
//     the resource sends an ABSOLUTE RELOCATION -- position 0x15 and
//     yaw 0x16, two consecutive 24-byte entries with the SAME key --
//     and on the half step that 60 Hz adds, the next end of the
//     animation is already expressed in the new coordinate system
//     while the physical root is still in the old one. Interpolating
//     between the two mixes two frames of reference: hence the sudden
//     rise and the sideways shift. This section re-expresses ONLY the
//     second end, before calling the native interpolator:
//
//         v1' = inverse(Rold) * (Rnew * v1 + Pnew - Pold)
//         q1' = inverse(Qold) * Qnew * q1
//
//     TWO hooks, and both land on a `jal`. That turns the usual three
//     decisions around: the jump to the cave is a `jal` -- so that $ra
//     stays hook+8 --, the delay slot is NOT touched -- it runs anyway
//     and IS part of the call: in rotation it is `move $a1, $sp`, an
//     argument -- and the routine replays nothing: it ends with a `j`
//     to the original interpolator, which returns to the caller by
//     itself.
//
//     Guards: the caller read from the stack (0x00104EC8 for position,
//     0x001050E0 with $s0 == 1 for rotation), the SceneAnim ancestor
//     0x00106B7C, dt == 1/60 with live divider 1 and $f20 == 1, events
//     enabled with at least two pending of types 0x15/0x16 and the same
//     key, the distance to the event between 0.25 and 0.75 keys of
//     30 Hz -- i.e. ONLY the half step -- and a current root of pure
//     yaw. At 30 fps both sites are inert.
//
//     position, cave 0x000E4000:
//       0x000E4000  27BDFFE0  addiu $sp, $sp, -32
//       0x000E4004  7FA80000  sq    $t0, 0($sp)
//       0x000E4008  7FA90010  sq    $t1, 16($sp)
//       0x000E400C  8FA80040  lw    $t0, 64($sp)
//       0x000E4010  3C090010  lui   $t1, 0x0010
//       0x000E4014  35294EC8  ori   $t1, $t1, 20168
//       0x000E4018  15090121  bne   $t0, $t1, 0x000E44A0
//       0x000E401C  00000000  nop
//       0x000E4020  8FA80090  lw    $t0, 144($sp)
//       0x000E4024  3C090010  lui   $t1, 0x0010
//       0x000E4028  35296B7C  ori   $t1, $t1, 27516
//       0x000E402C  1509011C  bne   $t0, $t1, 0x000E44A0
//       0x000E4030  00000000  nop
//       0x000E4034  3C080051  lui   $t0, 0x0051
//       0x000E4038  350802CC  ori   $t0, $t0, 716
//       0x000E403C  8D080000  lw    $t0, 0($t0)
//       0x000E4040  3C093C88  lui   $t1, 0x3C88
//       0x000E4044  35298889  ori   $t1, $t1, -30583
//       0x000E4048  15090115  bne   $t0, $t1, 0x000E44A0
//       0x000E404C  00000000  nop
//       0x000E4050  3C080059  lui   $t0, 0x0059
//       0x000E4054  35086D70  ori   $t0, $t0, 28016
//       0x000E4058  91080000  lbu   $t0, 0($t0)
//       0x000E405C  3C090000  lui   $t1, 0x0000
//       0x000E4060  35290001  ori   $t1, $t1, 1
//       0x000E4064  1509010E  bne   $t0, $t1, 0x000E44A0
//       0x000E4068  00000000  nop
//       0x000E406C  4408A000  mfc1  $t0, $f20
//       0x000E4070  3C093F80  lui   $t1, 0x3F80
//       0x000E4074  35290000  ori   $t1, $t1, 0

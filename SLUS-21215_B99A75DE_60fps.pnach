//
//     and only now the hook, a `j` WITHOUT its delay slot: the
//     `qmtc2 $v1, $vf2` runs live before the jump and is the new end
//     the lerp uses. The routine replays the `qmtc2 $a1, $vf4` at the
//     end and returns to 0x00336BD0. Section 44's `j` lands on this one.
patch=1,EE,00336BC8,word,0803A900

// 53. clockheal -- a save state made WITHOUT this patch, loaded with it.
//     This .pnach rewrites the code every frame, but the live timestep
//     (0x005102CC, seeded at boot by section 3) and the clock's copy
//     ([0x0050B734]+0x4C, on the heap) come from the save state. One
//     saved without the patch carries them at 1/30, and with the code at
//     60 the world would run fast until the next transition. The same
//     happens when the patch is enabled with the game already running.
//
//     This section hooks the FIRST word of the fixed-timestep
//     accumulator (0x003A2EA0, once per presented frame) and, if the
//     global or the copy are EXACTLY 1/30, sets them to 1/60. With the
//     patch active no writer in the game produces 1/30 (sections 3 and
//     6), so it only acts on a state without the patch, once. It DEPENDS
//     on sections 3 and 4. It clobbers $at, $v0 and $a1, which the
//     prologue writes before reading them; no stack or state. The
//     routine, in its cave:
//
//       0x000EAC00  3C013D08  lui   $at, 0x3D08
//       0x000EAC04  34218889  ori   $at, $at, -30583
//       0x000EAC08  8C6202CC  lw    $v0, 716($v1)
//       0x000EAC0C  14410003  bne   $v0, $at, 0x000EAC1C
//       0x000EAC10  3C023C88  lui   $v0, 0x3C88
//       0x000EAC14  34428889  ori   $v0, $v0, -30583
//       0x000EAC18  AC6202CC  sw    $v0, 716($v1)
//       0x000EAC1C  8C65B734  lw    $a1, -18636($v1)
//       0x000EAC20  3C020010  lui   $v0, 0x0010
//       0x000EAC24  00A2102B  sltu  $v0, $a1, $v0
//       0x000EAC28  1440000B  bne   $v0, $zero, 0x000EAC58
//       0x000EAC2C  3C020200  lui   $v0, 0x0200
//       0x000EAC30  00A2102B  sltu  $v0, $a1, $v0
//       0x000EAC34  10400008  beq   $v0, $zero, 0x000EAC58
//       0x000EAC38  30A20003  andi  $v0, $a1, 3
//       0x000EAC3C  14400006  bne   $v0, $zero, 0x000EAC58
//       0x000EAC40  00000000  nop
//       0x000EAC44  8CA2004C  lw    $v0, 76($a1)
//       0x000EAC48  14410003  bne   $v0, $at, 0x000EAC58
//       0x000EAC4C  3C023C88  lui   $v0, 0x3C88
//       0x000EAC50  34428889  ori   $v0, $v0, -30583
//       0x000EAC54  ACA2004C  sw    $v0, 76($a1)
//       0x000EAC58  080E8BAA  j     0x003A2EA8
//       0x000EAC5C  27BDFF60  addiu $sp, $sp, -160
//
patch=1,EE,000EAC00,word,3C013D08
patch=1,EE,000EAC04,word,34218889
patch=1,EE,000EAC08,word,8C6202CC
patch=1,EE,000EAC0C,word,14410003
patch=1,EE,000EAC10,word,3C023C88
patch=1,EE,000EAC14,word,34428889
patch=1,EE,000EAC18,word,AC6202CC
patch=1,EE,000EAC1C,word,8C65B734
patch=1,EE,000EAC20,word,3C020010
patch=1,EE,000EAC24,word,00A2102B
patch=1,EE,000EAC28,word,1440000B
patch=1,EE,000EAC2C,word,3C020200
patch=1,EE,000EAC30,word,00A2102B
patch=1,EE,000EAC34,word,10400008
patch=1,EE,000EAC38,word,30A20003
patch=1,EE,000EAC3C,word,14400006
patch=1,EE,000EAC40,word,00000000
patch=1,EE,000EAC44,word,8CA2004C
patch=1,EE,000EAC48,word,14410003
patch=1,EE,000EAC4C,word,3C023C88
patch=1,EE,000EAC50,word,34428889
patch=1,EE,000EAC54,word,ACA2004C
patch=1,EE,000EAC58,word,080E8BAA
patch=1,EE,000EAC5C,word,27BDFF60
//
//     and only now the hook, a `j` WITHOUT its delay slot: the
//     `lui $v1, 0x0051` runs live before the jump and is the base of the
//     two globals the routine reads. The routine replays the
//     `addiu $sp, $sp, -160` in the slot of its return, at 0x003A2EA8.
//     The `j` goes to the auto-off manager (section 70, 0x000C0000),
//     which chains this routine for as long as the patch stays ticked.
patch=1,EE,003A2EA0,word,08030000

// 54. grabwindow -- the Square window in the REAR GRAB. Cleon grabs a
//     Destroyer from behind and, depending on the frame, the window to
//     hit him with Square before he struggles was shorter than in stock
//     (valid starts 2/2/2 against 2/2/4 over three phases).
//
//     Two causes: the grabbed actor asks for the struggle with ZERO
//     wait and it comes out on the same update in which it is asked
//     for; and the actor loop alternates its direction (0..59 / 59..0,
//     [0x005104FC]) on every heavy update, which section 2 makes happen
//     on every frame.
//
//     This section, with dt 1/60 and live divider 1, in three hooks:
//     `order` (0x002494E0) skips the change of direction on EVEN
//     substeps, so it alternates at 30 Hz like stock -- for ALL actors,
//     not only in the grab; `ctor` (0x002FA984), with behaviour 31,
//     zero wait and the grabbed actor in CNS state 85, leaves the
//     native mark task+0x20 at 3 - direction instead of 1; and `tail`
//     (0x002F9EBC) counts it down to 1 answering 'not yet', and then
//     the native initialisation and first update follow. The struggle
//     starts one or two 60 Hz updates later. It is a compensation of
//     the window, not stock's exact schedule. It DEPENDS on sections 2
//     and 4. Each routine preserves the 128-bit $t0-$t2; no state of
//     its own. The routines, in their caves:
//
//       0x000EC800  27BDFFE0  addiu $sp, $sp, -32
//       0x000EC804  7FA80000  sq    $t0, 0($sp)
//       0x000EC808  7FA90010  sq    $t1, 16($sp)
//       0x000EC80C  3C030051  lui   $v1, 0x0051
//       0x000EC810  8C6204FC  lw    $v0, 1276($v1)
//       0x000EC814  3C080059  lui   $t0, 0x0059
//       0x000EC818  35086D70  ori   $t0, $t0, 28016
//       0x000EC81C  91080000  lbu   $t0, 0($t0)
//       0x000EC820  24090001  addiu $t1, $zero, 1
//       0x000EC824  15090013  bne   $t0, $t1, 0x000EC874
//       0x000EC828  00000000  nop
//       0x000EC82C  3C080051  lui   $t0, 0x0051
//       0x000EC830  350802CC  ori   $t0, $t0, 716
//       0x000EC834  8D080000  lw    $t0, 0($t0)
//       0x000EC838  3C093C88  lui   $t1, 0x3C88
//       0x000EC83C  35298889  ori   $t1, $t1, -30583
//       0x000EC840  1509000C  bne   $t0, $t1, 0x000EC874
//       0x000EC844  00000000  nop
//       0x000EC848  3C080051  lui   $t0, 0x0051
//       0x000EC84C  350804F4  ori   $t0, $t0, 1268
//       0x000EC850  8D080000  lw    $t0, 0($t0)
//       0x000EC854  31080001  andi  $t0, $t0, 1
//       0x000EC858  15000006  bne   $t0, $zero, 0x000EC874
//       0x000EC85C  00000000  nop
//       0x000EC860  7BA80000  lq    $t0, 0($sp)
//       0x000EC864  7BA90010  lq    $t1, 16($sp)
//       0x000EC868  27BD0020  addiu $sp, $sp, 32
//       0x000EC86C  0809253D  j     0x002494F4
//       0x000EC870  00000000  nop
//       0x000EC874  7BA80000  lq    $t0, 0($sp)
//       0x000EC878  7BA90010  lq    $t1, 16($sp)
//       0x000EC87C  27BD0020  addiu $sp, $sp, 32
//       0x000EC880  0809253A  j     0x002494E8
//       0x000EC884  00000000  nop
//       0x000ECC00  AE030020  sw    $v1, 32($s0)
//       0x000ECC04  AE000018  sw    $zero, 24($s0)
//       0x000ECC08  27BDFFD0  addiu $sp, $sp, -48
//       0x000ECC0C  7FA80000  sq    $t0, 0($sp)
//       0x000ECC10  7FA90010  sq    $t1, 16($sp)
//       0x000ECC14  7FAA0020  sq    $t2, 32($sp)
//       0x000ECC18  3C080059  lui   $t0, 0x0059
//       0x000ECC1C  35086D70  ori   $t0, $t0, 28016
//       0x000ECC20  91080000  lbu   $t0, 0($t0)
//       0x000ECC24  24090001  addiu $t1, $zero, 1
//       0x000ECC28  1509001E  bne   $t0, $t1, 0x000ECCA4
//       0x000ECC2C  00000000  nop
//       0x000ECC30  3C080051  lui   $t0, 0x0051
//       0x000ECC34  350802CC  ori   $t0, $t0, 716
//       0x000ECC38  8D080000  lw    $t0, 0($t0)
//       0x000ECC3C  3C093C88  lui   $t1, 0x3C88
//       0x000ECC40  35298889  ori   $t1, $t1, -30583
//       0x000ECC44  15090017  bne   $t0, $t1, 0x000ECCA4
//       0x000ECC48  00000000  nop
//       0x000ECC4C  2408001F  addiu $t0, $zero, 31
//       0x000ECC50  16280014  bne   $s1, $t0, 0x000ECCA4
//       0x000ECC54  00000000  nop
//       0x000ECC58  96080004  lhu   $t0, 4($s0)
//       0x000ECC5C  15000011  bne   $t0, $zero, 0x000ECCA4
//       0x000ECC60  00000000  nop
//       0x000ECC64  8E080000  lw    $t0, 0($s0)
//       0x000ECC68  8D080000  lw    $t0, 0($t0)
//       0x000ECC6C  8D0800D4  lw    $t0, 212($t0)
//       0x000ECC70  8D080020  lw    $t0, 32($t0)
//       0x000ECC74  24090055  addiu $t1, $zero, 85
//       0x000ECC78  1509000A  bne   $t0, $t1, 0x000ECCA4
//       0x000ECC7C  00000000  nop
//       0x000ECC80  3C080051  lui   $t0, 0x0051
//       0x000ECC84  350804FC  ori   $t0, $t0, 1276
//       0x000ECC88  8D080000  lw    $t0, 0($t0)
//       0x000ECC8C  2D090002  sltiu $t1, $t0, 2
//       0x000ECC90  11200004  beq   $t1, $zero, 0x000ECCA4
//       0x000ECC94  00000000  nop
//       0x000ECC98  24090003  addiu $t1, $zero, 3
//       0x000ECC9C  01284823  subu  $t1, $t1, $t0

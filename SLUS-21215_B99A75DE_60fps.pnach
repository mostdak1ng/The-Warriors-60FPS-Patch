// 47. sprintchord -- the CROSS-BODY while running: running with L2 and
//     the stick, Square has to do the cross-body.
//
//     The symptom: `chord30` (section 22) decides L2 + Square on the
//     EVEN grid of the ring, at 30 Hz, and the Square alone comes out
//     of the 60 Hz edge of another table. With the cursor odd, the
//     normal punch (action 15) won one frame before the cross-body (33)
//     and cut the run short: 4 of 8 ring positions.
//
//     This section hooks the ONLY caller of the chord classifier
//     (0x00144F48) and, only for L2 + Square and L2 + X with dt 1/60
//     and live divider 1, decides with the CURRENT sample and the one
//     two back (34 ms, stock's width). Everything else goes on through
//     a `j` to `chord30`'s classifier, which is not touched: the Strong
//     Attack and the combo stay as they are. No stack, no memory and no
//     state: only the temporaries the classifier already clobbers. The
//     routine, in its cave:
//
//       0x000E9400  24A2FFFF  addiu $v0, $a1, -1
//       0x000E9404  14400028  bne   $v0, $zero, 0x000E94A8
//       0x000E9408  00000000  nop
//       0x000E940C  24C2FF80  addiu $v0, $a2, -128
//       0x000E9410  10400004  beq   $v0, $zero, 0x000E9424
//       0x000E9414  00000000  nop
//       0x000E9418  24C2FFC0  addiu $v0, $a2, -64
//       0x000E941C  14400022  bne   $v0, $zero, 0x000E94A8
//       0x000E9420  00000000  nop
//       0x000E9424  3C020051  lui   $v0, 0x0051
//       0x000E9428  344202CC  ori   $v0, $v0, 716
//       0x000E942C  8C420000  lw    $v0, 0($v0)
//       0x000E9430  3C033C88  lui   $v1, 0x3C88
//       0x000E9434  34638889  ori   $v1, $v1, -30583
//       0x000E9438  1443001B  bne   $v0, $v1, 0x000E94A8
//       0x000E943C  00000000  nop
//       0x000E9440  3C020059  lui   $v0, 0x0059
//       0x000E9444  34426D70  ori   $v0, $v0, 28016
//       0x000E9448  90420000  lbu   $v0, 0($v0)
//       0x000E944C  24030001  addiu $v1, $zero, 1
//       0x000E9450  14430015  bne   $v0, $v1, 0x000E94A8
//       0x000E9454  00000000  nop
//       0x000E9458  2487001C  addiu $a3, $a0, 28
//       0x000E945C  00A62825  or    $a1, $a1, $a2
//       0x000E9460  8C84002C  lw    $a0, 44($a0)
//       0x000E9464  00041040  sll   $v0, $a0, 1
//       0x000E9468  00E21021  addu  $v0, $a3, $v0
//       0x000E946C  94430000  lhu   $v1, 0($v0)
//       0x000E9470  00651824  and   $v1, $v1, $a1
//       0x000E9474  10A30003  beq   $a1, $v1, 0x000E9484
//       0x000E9478  2483FFFE  addiu $v1, $a0, -2
//       0x000E947C  03E00008  jr    $ra
//       0x000E9480  0000102D  daddu $v0, $zero, $zero
//       0x000E9484  30630007  andi  $v1, $v1, 7
//       0x000E9488  00031840  sll   $v1, $v1, 1
//       0x000E948C  00E31821  addu  $v1, $a3, $v1
//       0x000E9490  94620000  lhu   $v0, 0($v1)
//       0x000E9494  00461024  and   $v0, $v0, $a2
